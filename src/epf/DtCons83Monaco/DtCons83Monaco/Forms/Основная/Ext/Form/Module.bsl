		ИЛИ СтраницаКодаПримера = "КодСервера1С" Тогда
		Если АлгоритмВыполнения = Неопределено Тогда
			Алгоритм[СтраницаКодаПримера] = Алгоритм[СтраницаКодаПримера] + ТекстПримера;
		Иначе
			ВидДокумента = ВидДокументаПоИмениПоляАлгоритма(СтраницаКодаПримера);
			ТекстДокумента = ПолучитьТекстДокументаРабочейОбласти(Алгоритм.УИД, ВидДокумента);
			ОбновитьТекстДокументаHTML(Алгоритм.УИД, ВидДокумента, ТекстДокумента + ТекстПримера);
		КонецЕсли;
	КонецЕсли;
	
	Если АлгоритмВыполнения = Неопределено Тогда
		ОбновитьТекст();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПримерВФонеНажатие(Команда, АлгоритмВыполнения = Неопределено, СтраницаКодаВыполнения = "")
	Алгоритм = ?(АлгоритмВыполнения = Неопределено, Элементы.Алгоритмы.ТекущиеДанные, АлгоритмВыполнения);
	СтраницаКодаПримера = ?(ПустаяСтрока(СтраницаКодаВыполнения), СтраницаКода, СтраницаКодаВыполнения);
	Если Алгоритм = Неопределено ИЛИ СтраницаКодаПримера <> "КодФоновойОбработки" Тогда
		Возврат;
	КонецЕсли;
	
	ТекстПримера = "
	|// ..::Этот текст отобразится в КонсолиЗаданий в Наименовании фонового::..
	|// Данный код передается как ""Алгоритм"" в фоновое задание - возвращает текстовый результат обработки
	|// На входе алгоритма ДополнительныеПараметры - Структура,
	|// где есть ключ ""Данные"" - Массив Структур строк ""Результата Запроса""
	|// перехват ошибок и вывод их - необходимо обрабатывать в Алгоритме
	|
	|// Пример: обход Результата и возврат текстового сообщения.
	|// В Данных должна быть Колонка/Свойство ""Cсылка""
	|
	|Результат = """"; //текстовый результат
	|КоличествоЗаписей = ДополнительныеПараметры.Данные.ВГраница();
	|
	|// ДополнительныеПараметры.Данные
	|Для каждого стрДанные из ДополнительныеПараметры.Данные цикл
	|	// Прогресс выполнения
	|	ПроцентОбработано = Окр(ДополнительныеПараметры.Данные.Найти(стрДанные) / КоличествоЗаписей * 100, 0);
	|	Если ПроцентОбработано % 1 = 0 Тогда
	|		ДлительныеОперации.СообщитьПрогресс(ПроцентОбработано);
	|	КонецЕсли;
	|	// Конец Прогресс выполнения
	|
	|	// об = стрДанные.ссылка.ПолучитьОбъект();
	|	попытка
	|		// об.Записать(режимЗаписиДокумента.Проведение);
	|		Результат = Результат + ""
	|		| Проведен "" + стрДанные.Наименование;
	|	исключение
	|		Результат = Результат + ""
	|		| Ошибка: "" + ОписаниеОшибки() + ""
	|		| "" + стрДанные.Наименование;
	|	КонецПопытки;
	|КонецЦикла;
	|
	|// помещаем текстовый результат для отображения на клиенте
	|ПоместитьВоВременноеХранилище(Результат, АдресРезультата);";
	
	Если АлгоритмВыполнения = Неопределено Тогда
		Алгоритм[СтраницаКодаПримера] = Алгоритм[СтраницаКодаПримера] + ТекстПримера;
	Иначе
		ТекстДокумента = ПолучитьТекстДокументаРабочейОбласти(Алгоритм.УИД, "background");
		ОбновитьТекстДокументаHTML(Алгоритм.УИД, "background", ТекстДокумента + ТекстПримера);
	КонецЕсли;
	
	Если АлгоритмВыполнения = Неопределено Тогда
		ОбновитьТекст();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКод(ВыполнитьКодСоСтраницы, ДополнительныеПараметры = Неопределено,
	АлгоритмВыполнения = Неопределено, ИспользоватьТекстРедактора = Истина,
	ТекстДокумента = Неопределено, КодПередВыполнением = Неопределено)
	Перем Параметры;
	Алгоритм = ?(АлгоритмВыполнения = Неопределено,
		Элементы.Алгоритмы.ТекущиеДанные, АлгоритмВыполнения);
	Если Алгоритм = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Контекст выполнения определяется переданным алгоритмом, а не текущей строкой формы.
	ТекущийАлгоритм = Алгоритм.УИД;
	СтраницаКода = ВыполнитьКодСоСтраницы;
	Если СтраницаКода = "КодЗапроса" Тогда
		ВыполнитьКодЗапроса(Алгоритм, ДополнительныеПараметры, ИспользоватьТекстРедактора,
			ТекстДокумента, КодПередВыполнением);
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("АлгоритмУИД", Алгоритм.УИД);
	НайденыеПараметры = Значения.НайтиСтроки(Отбор);
	Параметры = Новый Структура;
	Для Каждого ОписаниеПараметра Из НайденыеПараметры Цикл
		Параметры.Вставить(ОписаниеПараметра.Имя, ОписаниеПараметра.Значение);
	КонецЦикла;
	
	Если СтраницаКода = "КодКлиента1С" Тогда
		
		НачалоВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
		КодПросмотраПеременных = ПолучитьКодПросмотраПеременных("Форма");
		Текст = ?(ТекстДокумента = Неопределено,
			?(АлгоритмВыполнения = Неопределено, View().getText(), Алгоритм[СтраницаКода]), ТекстДокумента);
		Результат = ВыполнитьКодНаКлиенте(Текст, Параметры, КодПросмотраПеременных);

		ОкончаниеВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
		
		ОбработатьРезультатВыполнения(Результат);
		
		ОбщееВремяВыполнения = (ОкончаниеВыполнения - НачалоВыполнения);
		Возврат;
	КонецЕсли;
	
	Если СтраницаКода = "КодСервера1С" Тогда
		
		НачалоВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
		КодПросмотраПеременных = ПолучитьКодПросмотраПеременных();
		Текст = ?(ТекстДокумента = Неопределено,
			?(АлгоритмВыполнения = Неопределено, ПолучитьТекст(), Алгоритм[СтраницаКода]), ТекстДокумента);
		Результат = ВыполнитьКодНаСервере(Текст, Параметры, КодПросмотраПеременных);
		ОкончаниеВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();
		
		ОбработатьРезультатВыполнения(Результат);
		
		ОбщееВремяВыполнения = (ОкончаниеВыполнения - НачалоВыполнения);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКодЗапроса(Знач Алгоритм, Знач ДополнительныеПараметры,
	ИспользоватьТекстРедактора = Истина, Знач ТекстДокумента = Неопределено,
	Знач КодПередВыполнением = Неопределено)
	Перем ВыделенТекст, КонецКолонки, КонецСтроки, НачалоКолонки, НачалоСтроки, ТекстЗапроса;
	
	НачалоСтроки = 0;
	КонецСтроки = 0;
	НачалоКолонки = 0;
	КонецКолонки = 0;
	Если ИспользоватьТекстРедактора Тогда
		КонецСтроки = View().getCurrentLine();
		КонецКолонки = View().getCurrentColumn();

		Если ЗначениеЗаполнено(ДополнительныеПараметры)
			И ДополнительныеПараметры = "ДоКурсора" Тогда
			View().setSelection(НачалоСтроки, НачалоКолонки, КонецСтроки, КонецКолонки);
		КонецЕсли;

		ТекстЗапроса = View().selectedText();
		ВыделенТекст = ЗначениеЗаполнено(ТекстЗапроса);
	Иначе
		ТекстЗапроса = "";
		ВыделенТекст = Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
		ТекстЗапроса = ?(ТекстДокумента = Неопределено, Алгоритм[СтраницаКода], ТекстДокумента);
	КонецЕсли;
	
	ОбновитьТаблицыHTML(Новый Массив);
	ВыгрузитьДанныеНаСервере(ТекстЗапроса, БлокЗначений(ЭтотОбъект.Значения, Алгоритм.УИД),
		КодПередВыполнением);
	ОбновитьТаблицыHTML();
	
	Если ИспользоватьТекстРедактора И Не ВыделенТекст Тогда
		View().setSelection(КонецСтроки, КонецКолонки, КонецСтроки, КонецКолонки);
	КонецЕсли;
	
	Элементы.ДанныеВыполненияЗапроса.Заголовок = СтрШаблон("Время: %1 с. Кол. строк: %2", ОбщееВремяВыполнения / 1000, Выгрузка.Количество());

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСтруктуруРезультата()
	
	СтруктуруРезультата = Новый Структура();
	СтруктуруРезультата.Вставить("Успешно", Ложь);
	СтруктуруРезультата.Вставить("ИсходнаяСтрока", "");
	СтруктуруРезультата.Вставить("ОписаниеОшибки", "");
	СтруктуруРезультата.Вставить("ОписаниеПеременных", "");
	СтруктуруРезультата.Вставить("АдресХраненияПеременных", "");
	СтруктуруРезультата.Вставить("НомерСтроки", 0);
	СтруктуруРезультата.Вставить("НомерКолонки", 1);
	СтруктуруРезультата.Вставить("СтадияОшибки", "");
	
	Возврат СтруктуруРезультата;
	
КонецФункции

&НаКлиенте
Функция ВыполнитьКодНаКлиенте(Знач Текст, Знач Параметры = Неопределено, Знач КодПросмотраПеременных = "")
	ПодготовленныйМодуль = ПодготовитьМодульКода(Текст, КодПросмотраПеременных, "Форма");
	Если НЕ ПодготовленныйМодуль.ТребуетсяПолныйМодуль Тогда
		Возврат ВыполнитьКодСтраницыНаКлиенте(Текст + КодПросмотраПеременных, Параметры);
	КонецЕсли;

	КонтекстВыполнения = Новый Структура;
	КонтекстВыполнения.Вставить("Параметры", Параметры);
	КонтекстВыполнения.Вставить("Выгрузка", Выгрузка);
	КонтекстВыполнения.Вставить("Значения", Значения);
	КонтекстВыполнения.Вставить("ТекущийАлгоритм", ТекущийАлгоритм);

	Возврат ВыполнитьПолныйМодульНаКлиенте(ПодготовленныйМодуль, КонтекстВыполнения);
КонецФункции

&НаСервере
Функция ВыполнитьКодНаСервере(Знач Текст, Знач Параметры = Неопределено, Знач КодПросмотраПеременных = "")
	ПодготовленныйМодуль = ПодготовитьМодульКода(Текст, КодПросмотраПеременных);
	Если НЕ ПодготовленныйМодуль.ТребуетсяПолныйМодуль Тогда
		Возврат ВыполнитьКодСтраницы(Текст + КодПросмотраПеременных, Параметры);
	КонецЕсли;

	КонтекстВыполнения = Новый Структура;
	КонтекстВыполнения.Вставить("Параметры", Параметры);
	КонтекстВыполнения.Вставить("Выгрузка", ДанныеФормыВЗначение(Выгрузка, Тип("ТаблицаЗначений")));
	КонтекстВыполнения.Вставить("Значения", ДанныеФормыВЗначение(Значения, Тип("ТаблицаЗначений")));
	КонтекстВыполнения.Вставить("ТекущийАлгоритм", ТекущийАлгоритм);

	Результат = ВыполнитьПолныйМодульНаСервере(ПодготовленныйМодуль, КонтекстВыполнения);
	ЗначениеВРеквизитФормы(Результат.Выгрузка, "Выгрузка");
	ЗначениеВРеквизитФормы(Результат.Значения, "Значения");

	РезультатДляКлиента = ПолучитьСтруктуруРезультата();
	РезультатДляКлиента.Успешно = Результат.Успешно;
	РезультатДляКлиента.ИсходнаяСтрока = Результат.ИсходнаяСтрока;
	РезультатДляКлиента.ОписаниеОшибки = Результат.ОписаниеОшибки;
	РезультатДляКлиента.ОписаниеПеременных = Результат.ОписаниеПеременных;
	РезультатДляКлиента.АдресХраненияПеременных = Результат.АдресХраненияПеременных;
	РезультатДляКлиента.НомерСтроки = Результат.НомерСтроки;
	РезультатДляКлиента.НомерКолонки = Результат.НомерКолонки;
	РезультатДляКлиента.СтадияОшибки = Результат.СтадияОшибки;

	Возврат РезультатДляКлиента;
КонецФункции

&НаСервереБезКонтекста
Функция ПодготовитьМодульКода(Знач Текст, Знач КодПросмотраПеременных = "", Знач ТипМодуля = "Объект")
	Если ТипМодуля = "Форма" Тогда
		Текст = ЗаменитьПараметрыДляМодуляФормы(Текст);
	КонецЕсли;
	НормализованныйТекст = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
	СтрокиКода = СтрРазделить(НормализованныйТекст, Символы.ПС, Истина);
	ПризнакиСтрок = Новый Массив;
	ПризнакиСтрокКлиентскогоМетода = Новый Массив;
	Для Каждого СтрокаКода Из СтрокиКода Цикл
		ПризнакиСтрок.Добавить(Ложь);
		ПризнакиСтрокКлиентскогоМетода.Добавить(Ложь);
	КонецЦикла;

	ЕстьМетоды = Ложь;
	ЕстьДирективыПрепроцессора = Ложь;
	ЕстьОбъявленияПеременных = Ложь;
	ВнутриМетода = Ложь;
	КлиентскийМетод = Ложь;
	Для Индекс = 0 По СтрокиКода.ВГраница() Цикл
		СтрокаБезПробелов = ВРег(СокрЛП(СтрокиКода[Индекс])) + " ";
		Если СтрокаНачинаетсяС(СтрокаБезПробелов, "#") Тогда
			ЕстьДирективыПрепроцессора = Истина;
		КонецЕсли;
		Если ЭтоОбъявлениеПеременной(СтрокиКода[Индекс]) Тогда
			ЕстьОбъявленияПеременных = Истина;
		КонецЕсли;
		Если НЕ ВнутриМетода И ЭтоНачалоМетода(СтрокаБезПробелов) Тогда
			ЕстьМетоды = Истина;
			ВнутриМетода = Истина;
			КлиентскийМетод = ТипМодуля = "Форма" И ЭтоКлиентскийМетод(СтрокиКода, Индекс - 1);
			ПризнакиСтрок[Индекс] = Истина;
			ПризнакиСтрокКлиентскогоМетода[Индекс] = КлиентскийМетод;
			ПометитьКомментарииИДирективыМетода(СтрокиКода, ПризнакиСтрок, Индекс - 1);
		ИначеЕсли ВнутриМетода Тогда
			ПризнакиСтрок[Индекс] = Истина;
			ПризнакиСтрокКлиентскогоМетода[Индекс] = КлиентскийМетод;
			Если ЭтоКонецМетода(СтрокаБезПробелов) Тогда
				ВнутриМетода = Ложь;
				КлиентскийМетод = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	СгенерированныеСтроки = Новый Массив;
	ОсновнойКод = Новый Массив;
	КартаСтрок = Новый Соответствие;
	Если ТипМодуля = "Форма" Тогда
		СгенерированныеСтроки.Добавить("Перем ПарамDC83, ParamDC83X, Выгрузка, Значения, ТекущийАлгоритм;");
	Иначе
		СгенерированныеСтроки.Добавить("Перем Параметры, Выгрузка, Значения, ТекущийАлгоритм, SPd201bf6;");
	КонецЕсли;
	Для Индекс = 0 По СтрокиКода.ВГраница() Цикл
		СтрокаКода = СтрокиКода[Индекс];
		СтрокаБезПробелов = ВРег(СокрЛП(СтрокаКода)) + " ";
		ЭтоДирективаПрепроцессора = Лев(СокрЛП(СтрокаКода), 1) = "#";
		Если ПризнакиСтрок[Индекс]
			И (ТипМодуля <> "Форма" Или ПризнакиСтрокКлиентскогоМетода[Индекс])
			И (ЭтоВозвратИзМетода(СтрокаБезПробелов) Или ЭтоКонецМетода(СтрокаБезПробелов)) Тогда
			ДобавитьКодСбораПеременных(СгенерированныеСтроки, КартаСтрок,
				КодПросмотраПеременных, Индекс + 1);
		КонецЕсли;
		Если ПризнакиСтрок[Индекс] Или ЭтоОбъявлениеПеременной(СтрокаКода) Или ЭтоДирективаПрепроцессора Тогда
			СгенерированныеСтроки.Добавить(СтрокаКода);
		Иначе
			СгенерированныеСтроки.Добавить("");
			ОсновнойКод.Добавить(Новый Структура("Текст, НомерСтроки", СтрокаКода, Индекс + 1));
		КонецЕсли;
		Если ЭтоДирективаПрепроцессора И НЕ ПризнакиСтрок[Индекс]
			И ЭтоУсловнаяИнструкцияПрепроцессора(СтрокаБезПробелов) Тогда
			ОсновнойКод.Добавить(Новый Структура("Текст, НомерСтроки", СтрокаКода, Индекс + 1));
		КонецЕсли;
		КартаСтрок.Вставить(СгенерированныеСтроки.Количество(), Индекс + 1);
	КонецЦикла;

	СгенерированныеСтроки.Добавить("");
	Если ТипМодуля = "Форма" Тогда
		СгенерированныеСтроки.Добавить("&НаКлиенте");
	КонецЕсли;
	СгенерированныеСтроки.Добавить("Функция DC83ВыполнитьМодуль_6e6c2a(DC83Контекст_6e6c2a) Экспорт");
	Если ТипМодуля = "Форма" Тогда
		СгенерированныеСтроки.Добавить("ПарамDC83 = DC83Контекст_6e6c2a.Параметры;");
		СгенерированныеСтроки.Добавить("ParamDC83X = DC83Контекст_6e6c2a.Параметры;");
	Иначе
		СгенерированныеСтроки.Добавить("Параметры = DC83Контекст_6e6c2a.Параметры;");
	КонецЕсли;
	СгенерированныеСтроки.Добавить("Выгрузка = DC83Контекст_6e6c2a.Выгрузка;");
	СгенерированныеСтроки.Добавить("Значения = DC83Контекст_6e6c2a.Значения;");
	СгенерированныеСтроки.Добавить("ТекущийАлгоритм = DC83Контекст_6e6c2a.ТекущийАлгоритм;");
	СгенерированныеСтроки.Добавить("SPd201bf6 = Новый Структура;");

	Для Каждого СтрокаОсновногоКода Из ОсновнойКод Цикл
		СгенерированныеСтроки.Добавить(СтрокаОсновногоКода.Текст);
		КартаСтрок.Вставить(СгенерированныеСтроки.Количество(), СтрокаОсновногоКода.НомерСтроки);
	КонецЦикла;
	ДобавитьКодСбораПеременных(СгенерированныеСтроки, КартаСтрок,
		КодПросмотраПеременных, СтрокиКода.Количество());

	СгенерированныеСтроки.Добавить("DC83Результат_6e6c2a = Новый Структура;");
	СгенерированныеСтроки.Добавить("DC83Результат_6e6c2a.Вставить(""ЗначенияПеременных"", SPd201bf6);");
	СгенерированныеСтроки.Добавить("DC83Результат_6e6c2a.Вставить(""Выгрузка"", Выгрузка);");
	СгенерированныеСтроки.Добавить("DC83Результат_6e6c2a.Вставить(""Значения"", Значения);");
	СгенерированныеСтроки.Добавить("Возврат DC83Результат_6e6c2a;");
	СгенерированныеСтроки.Добавить("КонецФункции");

	ТребуетсяПолныйМодуль = ЕстьМетоды Или ЕстьДирективыПрепроцессора Или ЕстьОбъявленияПеременных;
	Возврат Новый Структура("ЕстьМетоды, ТребуетсяПолныйМодуль, Модуль, КартаСтрок, КоличествоСтрокИсходногоКода",
		ЕстьМетоды, ТребуетсяПолныйМодуль, СтрСоединить(СгенерированныеСтроки, Символы.ВК + Символы.ПС),
		КартаСтрок, СтрокиКода.Количество());
КонецФункции

&НаСервереБезКонтекста
Функция ЗаменитьПараметрыДляМодуляФормы(Знач Текст)
	Результат = "";
	Позиция = 1;
	ВнутриСтроки = Ложь;
	ДлинаТекста = СтрДлина(Текст);
	Пока Позиция <= ДлинаТекста Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если ВнутриСтроки Тогда
			Результат = Результат + Символ;
			Если Символ = """" Тогда
				Если Позиция < ДлинаТекста И Сред(Текст, Позиция + 1, 1) = """" Тогда
					Результат = Результат + """";
					Позиция = Позиция + 2;
					Продолжить;
				КонецЕсли;
				ВнутриСтроки = Ложь;
			КонецЕсли;
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		Если Символ = """" Тогда
			ВнутриСтроки = Истина;
			Результат = Результат + Символ;
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Если Символ = "/" И Позиция < ДлинаТекста И Сред(Текст, Позиция + 1, 1) = "/" Тогда
			КонецСтроки = СтрНайти(Текст, Символы.ПС, , Позиция);
			Если КонецСтроки = 0 Тогда
				Результат = Результат + Сред(Текст, Позиция);
				Прервать;
			КонецЕсли;
			Результат = Результат + Сред(Текст, Позиция, КонецСтроки - Позиция + 1);
			Позиция = КонецСтроки + 1;
			Продолжить;
		КонецЕсли;
		Если НЕ ЭтоСимволИдентификатора(Символ) Тогда
			Результат = Результат + Символ;
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		КонецИдентификатора = Позиция;
		Пока КонецИдентификатора <= ДлинаТекста
			И ЭтоСимволИдентификатора(Сред(Текст, КонецИдентификатора, 1)) Цикл
			КонецИдентификатора = КонецИдентификатора + 1;
		КонецЦикла;
		Идентификатор = Сред(Текст, Позиция, КонецИдентификатора - Позиция);
		ПредыдущийСимвол = ПредыдущийЗначимыйСимвол(Текст, Позиция - 1);
		ИдентификаторВРегистре = ВРег(Идентификатор);
		Если ПредыдущийСимвол <> "." И ИдентификаторВРегистре = "ПАРАМЕТРЫ" Тогда
			Результат = Результат + "ПарамDC83";
		ИначеЕсли ПредыдущийСимвол <> "." И ИдентификаторВРегистре = "PARAMETERS" Тогда
			Результат = Результат + "ParamDC83X";
		Иначе
			Результат = Результат + Идентификатор;
		КонецЕсли;
		Позиция = КонецИдентификатора;
	КонецЦикла;

	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоСимволИдентификатора(Знач Символ)
	Символ = ВРег(Символ);
	ДопустимыеСимволы = "ABCDEFGHIJKLMNOPQRSTUVWXYZАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ0123456789_";
	Возврат СтрНайти(ДопустимыеСимволы, Символ) > 0;
КонецФункции

&НаСервереБезКонтекста
Функция ПредыдущийЗначимыйСимвол(Текст, Позиция)
	Пока Позиция > 0 Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если НЕ (Символ = " " Или Символ = Символы.Таб Или Символ = Символы.ВК Или Символ = Символы.ПС) Тогда
			Возврат Символ;
		КонецЕсли;
		Позиция = Позиция - 1;
	КонецЦикла;
	Возврат "";
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоВозвратИзМетода(Строка)
	Возврат СтрокаНачинаетсяС(Строка, "ВОЗВРАТ ") Или СтрокаНачинаетсяС(Строка, "ВОЗВРАТ;")
		Или СтрокаНачинаетсяС(Строка, "RETURN ") Или СтрокаНачинаетсяС(Строка, "RETURN;");
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьКодСбораПеременных(СгенерированныеСтроки, КартаСтрок,
	Знач КодПросмотраПеременных, Знач НомерИсходнойСтроки)
	Если ПустаяСтрока(КодПросмотраПеременных) Тогда
		Возврат;
	КонецЕсли;

	НормализованныйКод = СтрЗаменить(КодПросмотраПеременных, Символы.ВК + Символы.ПС, Символы.ПС);
	СтрокиКода = СтрРазделить(НормализованныйКод, Символы.ПС, Истина);
	Для Каждого СтрокаКода Из СтрокиКода Цикл
		Если ПустаяСтрока(СокрЛП(СтрокаКода)) Тогда
			Продолжить;
		КонецЕсли;
		СгенерированныеСтроки.Добавить(СтрокаКода);
		КартаСтрок.Вставить(СгенерированныеСтроки.Количество(), НомерИсходнойСтроки);
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоНачалоМетода(Строка)
	Возврат СтрокаНачинаетсяС(Строка, "ПРОЦЕДУРА ") Или СтрокаНачинаетсяС(Строка, "ФУНКЦИЯ ")
		Или СтрокаНачинаетсяС(Строка, "АСИНХ ПРОЦЕДУРА ") Или СтрокаНачинаетсяС(Строка, "АСИНХ ФУНКЦИЯ ")
		Или СтрокаНачинаетсяС(Строка, "PROCEDURE ") Или СтрокаНачинаетсяС(Строка, "FUNCTION ")
		Или СтрокаНачинаетсяС(Строка, "ASYNC PROCEDURE ") Или СтрокаНачинаетсяС(Строка, "ASYNC FUNCTION ");
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоКонецМетода(Строка)
	Возврат СтрокаНачинаетсяС(Строка, "КОНЕЦПРОЦЕДУРЫ") Или СтрокаНачинаетсяС(Строка, "КОНЕЦФУНКЦИИ")
		Или СтрокаНачинаетсяС(Строка, "ENDPROCEDURE") Или СтрокаНачинаетсяС(Строка, "ENDFUNCTION");
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоОбъявлениеПеременной(Знач Строка)
	Строка = ВРег(СокрЛП(Строка));
	Возврат СтрокаНачинаетсяС(Строка, "ПЕРЕМ ") Или СтрокаНачинаетсяС(Строка, "VAR ");
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоКлиентскийМетод(СтрокиКода, Индекс)
	Пока Индекс >= 0 Цикл
		Строка = ВРег(СокрЛП(СтрокиКода[Индекс]));
		Если ПустаяСтрока(Строка) Или Лев(Строка, 2) = "//" Тогда
			Индекс = Индекс - 1;
			Продолжить;
		КонецЕсли;
		Возврат Строка = "&НАКЛИЕНТЕ";
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоУсловнаяИнструкцияПрепроцессора(Строка)
	Возврат СтрокаНачинаетсяС(Строка, "#ЕСЛИ ") Или СтрокаНачинаетсяС(Строка, "#IF ")
		Или СтрокаНачинаетсяС(Строка, "#ИНАЧЕЕСЛИ ") Или СтрокаНачинаетсяС(Строка, "#ELSIF ")
		Или СтрокаНачинаетсяС(Строка, "#ИНАЧЕ ") Или СтрокаНачинаетсяС(Строка, "#ELSE ")
		Или СтрокаНачинаетсяС(Строка, "#КОНЕЦЕСЛИ") Или СтрокаНачинаетсяС(Строка, "#ENDIF");
КонецФункции

&НаСервереБезКонтекста
Функция СтрокаНачинаетсяС(Строка, НачалоСтроки)
	Возврат Лев(Строка, СтрДлина(НачалоСтроки)) = НачалоСтроки;
КонецФункции

&НаСервереБезКонтекста
Процедура ПометитьКомментарииИДирективыМетода(СтрокиКода, ПризнакиСтрок, Индекс)
	Пока 0 <= Индекс Цикл
		Строка = СокрЛП(СтрокиКода[Индекс]);
		Если ПустаяСтрока(Строка) Или Лев(Строка, 2) = "//" Или Лев(Строка, 1) = "&" Тогда
			ПризнакиСтрок[Индекс] = Истина;
			Индекс = Индекс - 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ВыполнитьПолныйМодульНаКлиенте(Знач ПодготовленныйМодуль, Знач КонтекстВыполнения)
	Результат = ПолучитьСтруктуруРезультата();
	ИмяИсполнителя = "";
	ФормаИсполнитель = Неопределено;
	СтадияОшибки = "Формирование";

	Попытка
		СтадияОшибки = "Компиляция";
		ИмяИсполнителя = ПодключитьИсполнительКодаКлиента(ПодготовленныйМодуль.Модуль);

		ИмяФормыИсполнителя = "ВнешняяОбработка." + ИмяИсполнителя + ".Форма.ИсполнительКодаКлиент";
		ФормаИсполнитель = ПолучитьФорму(ИмяФормыИсполнителя,
			Неопределено, ЭтаФорма, Новый УникальныйИдентификатор);
		Если ФормаИсполнитель = Неопределено Тогда
			ВызватьИсключение "Не удалось создать форму исполнителя кода.";
		КонецЕсли;

		СтадияОшибки = "Выполнение";
		РезультатИсполнителя = ФормаИсполнитель.DC83ВыполнитьМодуль_6e6c2a(КонтекстВыполнения);
		Результат.Успешно = Истина;
		АдресПеременных = "";
		Если ПоказыватьЗначенияПеременныхПослеВыполнения = 1 Тогда
			Результат.ОписаниеПеременных = ПолучитьОписаниеПеременныхДляВыводВТабло(
				РезультатИсполнителя.ЗначенияПеременных, АдресПеременных);
		ИначеЕсли ПоказыватьЗначенияПеременныхПослеВыполнения = 2 Тогда
			Результат.ОписаниеПеременных = ПолучитьПредставлениеПеременныхДляВсплывающихПодсказок(
				РезультатИсполнителя.ЗначенияПеременных);
		КонецЕсли;
		Результат.АдресХраненияПеременных = АдресПеременных;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЗаполнитьОшибкуВыполнения(Результат, ИнформацияОбОшибке, СтадияОшибки, ПодготовленныйМодуль);
	КонецПопытки;

	ФормаИсполнитель = Неопределено;

	Возврат Результат;
КонецФункции

&НаСервере
Функция ПодключитьИсполнительКодаКлиента(Знач ТекстМодуля)
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("epf");
	ИмяИсполнителя = "";
	АдресИсполнителя = "";
	Попытка
		ЗаписатьВременнуюОбработку(ТекстМодуля, ИмяВременногоФайла, "Форма");
		ДвоичныеДанныеИсполнителя = Новый ДвоичныеДанные(ИмяВременногоФайла);
		АдресИсполнителя = ПоместитьВоВременноеХранилище(
			ДвоичныеДанныеИсполнителя, Новый УникальныйИдентификатор);
		ИмяИсполнителя = ВнешниеОбработки.Подключить(АдресИсполнителя, , Истина);
		Если НЕ ЗначениеЗаполнено(ИмяИсполнителя) Тогда
			ВызватьИсключение "Не удалось подключить обработку исполнителя кода.";
		КонецЕсли;
	Исключение
		Если ЗначениеЗаполнено(ИмяВременногоФайла) Тогда
			Попытка
				УдалитьФайлы(ИмяВременногоФайла);
			Исключение
			КонецПопытки;
		КонецЕсли;
		Если ЗначениеЗаполнено(АдресИсполнителя) Тогда
			Попытка
				УдалитьИзВременногоХранилища(АдресИсполнителя);
			Исключение
			КонецПопытки;
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
	КонецПопытки;
	Если ЗначениеЗаполнено(АдресИсполнителя) Тогда
		Попытка
			УдалитьИзВременногоХранилища(АдресИсполнителя);
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат ИмяИсполнителя;
КонецФункции

&НаСервере
Функция ВыполнитьПолныйМодульНаСервере(Знач ПодготовленныйМодуль, Знач КонтекстВыполнения)
	Результат = ПолучитьСтруктуруРезультата();
	Результат.Вставить("Выгрузка", КонтекстВыполнения.Выгрузка);
	Результат.Вставить("Значения", КонтекстВыполнения.Значения);
	ИмяВременногоФайла = "";
	ОбработкаИсполнитель = Неопределено;
	СтадияОшибки = "Компиляция";

	Попытка
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("epf");
		ЗаписатьВременнуюОбработку(ПодготовленныйМодуль.Модуль, ИмяВременногоФайла);
		ОбработкаИсполнитель = ВнешниеОбработки.Создать(ИмяВременногоФайла, Истина);
		СтадияОшибки = "Выполнение";
		РезультатИсполнителя = ОбработкаИсполнитель.DC83ВыполнитьМодуль_6e6c2a(КонтекстВыполнения);
		Результат.Успешно = Истина;
		Результат.Выгрузка = РезультатИсполнителя.Выгрузка;
		Результат.Значения = РезультатИсполнителя.Значения;
		АдресПеременных = "";
		Если ПоказыватьЗначенияПеременныхПослеВыполнения = 1 Тогда
			Результат.ОписаниеПеременных = ПолучитьОписаниеПеременныхДляВыводВТабло(РезультатИсполнителя.ЗначенияПеременных, АдресПеременных);
		ИначеЕсли ПоказыватьЗначенияПеременныхПослеВыполнения = 2 Тогда
			Результат.ОписаниеПеременных = ПолучитьПредставлениеПеременныхДляВсплывающихПодсказок(РезультатИсполнителя.ЗначенияПеременных);
		КонецЕсли;
		Результат.АдресХраненияПеременных = АдресПеременных;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЗаполнитьОшибкуВыполнения(Результат, ИнформацияОбОшибке, СтадияОшибки, ПодготовленныйМодуль);
	КонецПопытки;

	ОбработкаИсполнитель = Неопределено;
	Если ЗначениеЗаполнено(ИмяВременногоФайла) Тогда
		Попытка
			УдалитьФайлы(ИмяВременногоФайла);
		Исключение
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;
КонецФункции

&НаСервере
Процедура ЗаписатьВременнуюОбработку(ТекстМодуля, ИмяФайла, ТипМодуля = "Объект")
	Макет = ПолучитьМакет("ИсполнительКодаСервер");
	ШестнадцатеричныеДанные = ПолучитьHexСтрокуИзДвоичныхДанных(Макет);

	Если ТипМодуля = "Форма" Тогда
		ТекстМаркераНачала = "// __DC83_FORM_MODULE_SLOT_START__";
		ТекстМаркераКонца = "// __DC83_FORM_MODULE_SLOT_END__";
	ИначеЕсли ТипМодуля = "Объект" Тогда
		ТекстМаркераНачала = "// __DC83_MODULE_SLOT_START__";
		ТекстМаркераКонца = "// __DC83_MODULE_SLOT_END__";
	Иначе
		ВызватьИсключение "Неизвестный тип модуля исполнителя кода: " + ТипМодуля;
	КонецЕсли;

	МаркерНачала = ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтроки(
		ТекстМаркераНачала, КодировкаТекста.UTF8, Ложь));
	МаркерКонца = ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтроки(
		ТекстМаркераКонца, КодировкаТекста.UTF8, Ложь));
	ПозицияНачала = СтрНайти(ШестнадцатеричныеДанные, МаркерНачала);
	ПозицияКонца = СтрНайти(ШестнадцатеричныеДанные, МаркерКонца);
	Если ПозицияНачала = 0 Или ПозицияКонца = 0 Или ПозицияКонца <= ПозицияНачала Тогда
		ВызватьИсключение "Поврежден макет исполнителя кода.";
	КонецЕсли;

	НачалоСлота = ПозицияНачала + СтрДлина(МаркерНачала);
	ДлинаСлота = ПозицияКонца - НачалоСлота;
	Если ТипМодуля = "Форма" Тогда
		ТекстМодуляДляХранилища = СтрЗаменить(ТекстМодуля, """", """""");
	Иначе
		ТекстМодуляДляХранилища = ТекстМодуля;
	КонецЕсли;
	ТекстДляСлота = Символы.ВК + Символы.ПС + ТекстМодуляДляХранилища + Символы.ВК + Символы.ПС;
	ДанныеМодуля = ПолучитьДвоичныеДанныеИзСтроки(ТекстДляСлота, КодировкаТекста.UTF8, Ложь);
	HexМодуля = ПолучитьHexСтрокуИзДвоичныхДанных(ДанныеМодуля);
	Если СтрДлина(HexМодуля) > ДлинаСлота Тогда
		ВызватьИсключение "Код модуля превышает допустимый размер шаблона.";
	КонецЕсли;

	HexМодуля = ДополнитьСтроку(HexМодуля, (ДлинаСлота - СтрДлина(HexМодуля)) / 2, "20", Ложь);
	ШестнадцатеричныеДанные = Лев(ШестнадцатеричныеДанные, НачалоСлота - 1) + HexМодуля + Сред(ШестнадцатеричныеДанные, ПозицияКонца);
	ПолучитьДвоичныеДанныеИзHexСтроки(ШестнадцатеричныеДанные).Записать(ИмяФайла);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьОшибкуВыполнения(Результат, ИнформацияОбОшибке, СтадияОшибки, ПодготовленныйМодуль)
	Результат.ИсходнаяСтрока = ИнформацияОбОшибке.ИсходнаяСтрока;
	Если ИнформацияОбОшибке.Причина <> Неопределено Тогда
		Результат.ОписаниеОшибки = ИнформацияОбОшибке.Причина.Описание;
	Иначе
		Результат.ОписаниеОшибки = ИнформацияОбОшибке.Описание;
	КонецЕсли;
	Результат.СтадияОшибки = СтадияОшибки;

	Ошибка = ПолучитьОшибку(Результат.ОписаниеОшибки);
	Результат.НомерСтроки = Ошибка.НомерСтроки;
	Результат.НомерКолонки = Ошибка.НомерКолонки;
	ИсходныйНомерСтроки = ПодготовленныйМодуль.КартаСтрок.Получить(Результат.НомерСтроки);
	Если ИсходныйНомерСтроки <> Неопределено Тогда
		Результат.НомерСтроки = ИсходныйНомерСтроки;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВыполнитьКодСтраницы(Знач Текст, Знач Параметры)
	RVS6e6c2a = ПолучитьСтруктуруРезультата();
	SPd201bf6 = Новый Структура();
	
	Попытка
		Выполнить(Текст);
		RVS6e6c2a.Успешно = Истина;
		АдресПеременных = "";
		Попытка
			Если ПоказыватьЗначенияПеременныхПослеВыполнения = 1 Тогда
				RVS6e6c2a.ОписаниеПеременных = ПолучитьОписаниеПеременныхДляВыводВТабло(SPd201bf6, АдресПеременных);
			ИначеЕсли ПоказыватьЗначенияПеременныхПослеВыполнения = 2 Тогда
				RVS6e6c2a.ОписаниеПеременных = ПолучитьПредставлениеПеременныхДляВсплывающихПодсказок(SPd201bf6);
			КонецЕсли;
			RVS6e6c2a.АдресХраненияПеременных = АдресПеременных;
		Исключение
			OS6e6c2a = ИнформацияОбОшибке();
			RVS6e6c2a.ОписаниеПеременных = "";
		КонецПопытки;
	Исключение
		OS6e6c2a = ИнформацияОбОшибке();
		RVS6e6c2a.ИсходнаяСтрока = OS6e6c2a.ИсходнаяСтрока;
		Если OS6e6c2a.Причина <> Неопределено Тогда
			RVS6e6c2a.ОписаниеОшибки = OS6e6c2a.Причина.Описание;
		Иначе
			RVS6e6c2a.ОписаниеОшибки = OS6e6c2a.Описание;
		КонецЕсли;
	КонецПопытки;
	
	Возврат RVS6e6c2a;
КонецФункции

