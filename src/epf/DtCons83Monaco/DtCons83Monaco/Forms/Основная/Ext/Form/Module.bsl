	Операция = Новый Структура();
	Операция.Вставить("op", "replaceDocumentText");
	Операция.Вставить("documentId", Строка(АлгоритмУИД) + ":" + ВидДокумента);
	Операция.Вставить("text", ТекстДокумента);
	Операция.Вставить("hasContent", ЗначениеЗаполнено(ТекстДокумента));

	Операции = Новый Массив;
	Операции.Добавить(Операция);
	Изменения = Новый Структура("operations", Операции);

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Изменения);

	Попытка
		Результат = QueryView().DataConsoleApp.applyPatch(Запись.Закрыть());
		Попытка
			Если ЗначениеЗаполнено(Результат.errorDescription) Тогда
				ВывестиОшибку(Результат.errorDescription, Ложь);
			КонецЕсли;
		Исключение
		КонецПопытки;
	Исключение
		ВывестиОшибку("Не удалось обновить текст документа HTML-редактора: " + ОписаниеОшибки(), Ложь);
	КонецПопытки;

