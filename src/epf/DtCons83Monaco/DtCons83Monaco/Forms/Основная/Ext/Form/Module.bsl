&НаКлиенте
Асинх Процедура ВывестиВТабДок(Команда)
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	ТекущиеДанные = Элементы.Таблицы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	Адрес = ВывестиВТабДокНаСервере(ТекущиеДанные.РезультатЗапроса);
	
	ИмяФайла = ПолучитьИмяВременногоФайла("csv");
	ПолученныйФайл = Ждать ПолучитьФайлССервераАсинх(Адрес, ИмяФайла);
	ИмяФайла = ПолученныйФайл.ПолноеИмя;
	
	Сообщить("Записан за " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000 + " сек");

	СохранитьФайлВыгрузки(ИмяФайла);
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВCSV(Команда)
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ИменаКолонок = ИменаКолонокВыгрузки(Элементы.Выгрузка.ПодчиненныеЭлементы);
	
	ИмяФайла = ВывестиРезультатВФайл(Выгрузка, ИменаКолонок);
	
	Сообщить("Записан за " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000 + " сек");

	СохранитьФайлВыгрузки(ИмяФайла, "csv");
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИменаКолонокВыгрузки(Знач ЭлементыВыгрузки)
	Перем ИменаКолонок, Реквизит;
	
	ИменаКолонок = Новый Массив;
	
	Для Каждого Реквизит Из ЭлементыВыгрузки Цикл
		Если СтрЗаканчиваетсяНа(Реквизит.Имя, "_К") 
			ИЛИ СтрЗаканчиваетсяНа(Реквизит.Имя, "_П")
			ИЛИ СтрЗаканчиваетсяНа(Реквизит.Имя, "__СлужебныйРасшифровка__") Тогда
			Продолжить;
		КонецЕсли;
		ИменаКолонок.Добавить(СтрЗаменить(Реквизит.Имя, "Выгрузка", ""));
	КонецЦикла;
	Возврат ИменаКолонок;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВывестиРезультатВФайл(Знач Выгрузка, Знач ИменаКолонок)
	Перем стрВыгрузка, ЗаписьТекста, ИмяКолонки, ИмяФайла;
	
	МаксКолВоСтрокДляЗаписи = 9999;
	Счетчик = 0;
	
	ЧастиСтроки = Новый Массив;
	ЧастиТекста = Новый Массив;

	ИмяФайла = ПолучитьИмяВременногоФайла("csv");
	
	ЗаписьТекста = Новый ЗаписьТекста;
	ЗаписьТекста.Открыть(ИмяФайла);
	
	ЧастиТекста.Добавить(СтрСоединить(ИменаКолонок, ";"));
	Для Каждого стрВыгрузка Из Выгрузка Цикл
		Счетчик = Счетчик + 1;
		
		ЧастиСтроки.Очистить();
		Для Каждого ИмяКолонки Из ИменаКолонок Цикл
			ЧастиСтроки.Добавить(стрВыгрузка[ИмяКолонки]);
		КонецЦикла;
		
		ЧастиТекста.Добавить(СтрСоединить(ЧастиСтроки, ";"));
		
		Если Счетчик > МаксКолВоСтрокДляЗаписи Тогда
			ЗаписьТекста.ЗаписатьСтроку(СтрСоединить(ЧастиТекста, Символы.ПС));
			ЧастиТекста.Очистить();
			Счетчик = 0;
		КонецЕсли;
	КонецЦикла;
	
	Если ЧастиТекста.Количество() > 0 Тогда
		ЗаписьТекста.ЗаписатьСтроку(СтрСоединить(ЧастиТекста, Символы.ПС));
	КонецЕсли;
	
	ЗаписьТекста.Закрыть();
	
	#Если Клиент Тогда
	Возврат ИмяФайла;
	#Иначе
	Возврат ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайла));
	#КонецЕсли

КонецФункции

&НаКлиенте
Асинх Процедура СохранитьФайлВыгрузки(ИмяФайлаИсточника, Расширение = "csv")
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Расширение = Расширение;
	Диалог.Фильтр = СтрШаблон("Формат %1(*.%1)|*.%1", Расширение);
	Диалог.МножественныйВыбор = Ложь;
	Результат = Ждать Диалог.ВыбратьАсинх();
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайла = Результат[0];
	ПереместитьФайлАсинх(ИмяФайлаИсточника, ИмяФайла);
	
	Сообщить(ИмяФайла);
	
	ОткрытьПроводник(Новый Файл(ИмяФайла), Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПроводник(Контекст, ЭтоФайл) Экспорт 
	
	// АПК:534-выкл методы безопасного запуска обеспечиваются этой функцией
	
	ФайлИнфо = Контекст;
	
	Оповещение = Новый ОписаниеОповещения(,,, "ОткрытьПроводникПриОбработкеОшибки", ЭтотОбъект);
	Если ЭтоФайл Тогда
		Если ЭтоWindowsКлиент() Тогда
			НачатьЗапускПриложения(Оповещение, "explorer.exe /select, """ + ФайлИнфо.ПолноеИмя + """");
		Иначе // Это Linux или macOS.
			НачатьЗапускПриложения(Оповещение, "file:///" + ФайлИнфо.Путь);
		КонецЕсли;
	Иначе // Это каталог.
		НачатьЗапускПриложения(Оповещение, "file:///" + ФайлИнфо.ПолноеИмя);
	КонецЕсли;
	
	// АПК:534-вкл
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПроводникПриОбработкеОшибки(ИнформацияОбОшибке, СтандартнаяОбработка, Контекст) Экспорт 
	
	СтандартнаяОбработка = Ложь;
	ОткрытьПроводникОповеститьОбОшибке("", Контекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПроводникОповеститьОбОшибке(ОписаниеОшибки, Контекст)
	
	Если Не ПустаяСтрока(ОписаниеОшибки) Тогда 
		ПредупреждениеАсинх(ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

