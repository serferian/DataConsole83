&НаКлиенте
Функция СформироватьJSONРабочейОбласти()

	Если ПустаяСтрока(ИдентификаторРабочейОбласти) Тогда
		ИдентификаторРабочейОбласти = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;

	Снимок = Новый Структура();
	Снимок.Вставить("formatVersion", 5);
	Снимок.Вставить("sessionId", ИдентификаторРабочейОбласти);
	Снимок.Вставить("fileName", Объект.ПолноеИмяФайла);
	Снимок.Вставить("modified", ЭтотОбъект.Модифицированность);
	Снимок.Вставить("revision", 0);
	Снимок.Вставить("fileHash", "");
	Снимок.Вставить("canExecute", НЕ ТолькоПросмотр);
	Снимок.Вставить("selectedAlgorithmId", ТекущийАлгоритм);
	Снимок.Вставить("selectedTableId", ИдентификаторТекущейТаблицыРабочейОбласти());
	Снимок.Вставить("measurementsEnabled", ВключеныЗамерыЗапросов);
	Снимок.Вставить("tables", СформироватьТаблицыРабочейОбласти());
	Снимок.Вставить("settings", СформироватьНастройкиРабочейОбласти());
	Снимок.Вставить("algorithms", СформироватьАлгоритмыРабочейОбласти(ЭтотОбъект.Алгоритмы.ПолучитьЭлементы()));

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Снимок);

	Возврат Запись.Закрыть();

КонецФункции

