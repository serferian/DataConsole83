	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруВнешнегоИсточникаДанных(ОбъектМетаданных)
	
	СтруктураИсточника = Новый Структура();
	
	ОписаниеТаблиц = Новый Структура();
	
	Для Каждого Таблица Из ОбъектМетаданных.Таблицы Цикл
		
		ОбъектныеДанные = Метаданные.СвойстваОбъектов.ТипДанныхТаблицыВнешнегоИсточникаДанных.ОбъектныеДанные;
		ТипТаблицы = ?(Таблица.ТипДанныхТаблицы = ОбъектныеДанные, "ObjectData", "NonobjectData");
		
		СтруктураТаблицы = Новый Структура();
		СтруктураТаблицы.Вставить("tableDataType", ТипТаблицы);
		
		ПоляТаблицы = Новый Структура();
		Для Каждого Поле Из Таблица.Поля Цикл
			ПоляТаблицы.Вставить(Поле.Имя, Новый Структура("name", Поле.Синоним));
		КонецЦикла;
		
		СтруктураТаблицы.Вставить("properties", ПоляТаблицы);
		
		ОписаниеТаблиц.Вставить(Таблица.Имя, СтруктураТаблицы);
		
	КонецЦикла;
	
	СтруктураИсточника.Вставить("tables", Новый Структура("items", ОписаниеТаблиц));
	
	Возврат СтруктураИсточника;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьСтруктуруОбъектаДляВнешнегоИсточникаДанных(СтруктураОбъекта, ОбъектМетаданных)
	
	СтруктураИсточника = ПолучитьСтруктуруВнешнегоИсточникаДанных(ОбъектМетаданных);
	Для Каждого Обход Из СтруктураИсточника Цикл
		СтруктураОбъекта.Вставить(Обход.Ключ, Обход.Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьСтруктуруОбъектаМетаданных(СтруктураОбъекта, ОбъектМетаданных, ПолноеИмя)
	
	ОписаниеРеквизитов = Новый Структура();
	ОписаниеРесурсов = Новый Структура();
	ОписаниеПредопределенных = Новый Структура();
	ОписаниеТабличныхЧастей = Новый Структура();
	ДополнительныеСвойства = Новый Структура();
	
	Связи = Новый Соответствие();
	
	Если ИмяМетаданных(ПолноеИмя) = "Перечисление" Тогда
		ЗаполнитьОписаниеЗначенийПеречисления(ОбъектМетаданных, ОписаниеРеквизитов);
	Иначе
		ЗаполнитьОписаниеРеквизитов(ОбъектМетаданных, ОписаниеРеквизитов, Связи);
		ЗаполнитьОписаниеСтандартныхРеквизитов(ОбъектМетаданных, ПолноеИмя, ОписаниеРеквизитов, Связи);
		ЗаполнитьОписаниеПредопределенныхЭлементов(ОбъектМетаданных, ПолноеИмя, ОписаниеПредопределенных);
		ЗаполнитьОписаниеИзмеренийРесурсов(ОбъектМетаданных, ПолноеИмя,
			ОписаниеРеквизитов, ОписаниеРесурсов, ДополнительныеСвойства, Связи);
		ЗаполнитьОписаниеТабличныхЧастей(ОбъектМетаданных, ПолноеИмя, ОписаниеРеквизитов, ОписаниеТабличныхЧастей, Связи);
	КонецЕсли;
	
	СтруктураОбъекта.Вставить("properties", ОписаниеРеквизитов);
	
	Для Каждого Обход Из ДополнительныеСвойства Цикл
		СтруктураОбъекта.Вставить(Обход.Ключ, Обход.Значение);
	КонецЦикла;
	
	Если 0 < ОписаниеРесурсов.Количество() Тогда
		СтруктураОбъекта.Вставить("resources", ОписаниеРесурсов);
	КонецЕсли;
	
	Если 0 < ОписаниеПредопределенных.Количество() Тогда
		СтруктураОбъекта.Вставить("predefined", ОписаниеПредопределенных); 
	КонецЕсли;
	
	Если 0 < ОписаниеТабличныхЧастей.Количество() Тогда
		СтруктураОбъекта.Вставить("tabulars", ОписаниеТабличныхЧастей); 
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОписаниеОбъектаМетаданных(ТипОбъекта, АдресОбновления)
	
	ОписаниеМетаданных = "";
	
	Части = СтрРазделить(ТипОбъекта, ".");
	
	ИмяКоллекции = ПолучитьИмяКоллекцииМетаданныхПоТипу(Части[0]);
	
	Если ЗначениеЗаполнено(ИмяКоллекции) Тогда
		
		ОбъектМетаданных = Метаданные[Части[0]][Части[1]];
		ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		
		СтруктураОбъекта = Новый Структура();
		
		Если 0 < СтрНайти(ИмяМетаданных(ПолноеИмя), "ВнешнийИсточникДанных") Тогда
			ЗаполнитьСтруктуруОбъектаДляВнешнегоИсточникаДанных(СтруктураОбъекта, ОбъектМетаданных);
		Иначе
			ЗаполнитьСтруктуруОбъектаМетаданных(СтруктураОбъекта, ОбъектМетаданных, ПолноеИмя);
		КонецЕсли;
		
		Файл = Новый ЗаписьJSON();
		Файл.УстановитьСтроку();
		Попытка
			ЗаписатьJSON(Файл, СтруктураОбъекта);
		Исключение
			ВызватьИсключение("Не удалось сохранить коллекцию метаданных:" + Символы.ПС + ОписаниеОшибки());
		КонецПопытки;
		
		АдресОбновления = ИмяКоллекции + ".items." + ОбъектМетаданных.Имя;
		
		ОписаниеМетаданных = Файл.Закрыть();
		
	КонецЕсли;
	
	Возврат ОписаниеМетаданных;
	
КонецФункции

&НаКлиенте
Функция ЗагрузитьОбъектМетаданныхПоЗапросу(ПараметрыЗапроса)
	
	АдресОбновления = "";
	ОписаниеМетаданных = ПолучитьОписаниеОбъектаМетаданных(ПараметрыЗапроса, АдресОбновления);
	
	Если ЗначениеЗаполнено(ОписаниеМетаданных) Тогда
		
		Если ТипЗнч(View().updateMetadata(ОписаниеМетаданных, АдресОбновления)) = Тип("Булево") Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ЗагрузитьСписокМетаданныхПоЗапросу(ПараметрыЗапроса)
	
	АдресОбновления = "";
	ОписаниеМетаданных = ПолучитьСписокОбъектовМетаданных(ПараметрыЗапроса, АдресОбновления);
		
	Если ЗначениеЗаполнено(ОписаниеМетаданных) Тогда
		
		Если ТипЗнч(View().updateMetadata(ОписаниеМетаданных, АдресОбновления)) = Тип("Булево") Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаСобытияПолученияМетаданных(Событие)
	
	ПараметрыЗапроса = НРег(Событие.metadata);
	ВызыватьПодсказку = (Событие.trigger = "suggestion");
	ДанныеОбновлены = Ложь;
	
	Если 0 < СтрНайти(ПараметрыЗапроса, ".") Тогда
		
		ЧастиЗапроса = СтрРазделить(ПараметрыЗапроса, ".");
		
		Если ЧастиЗапроса[0] = "module" Тогда
			
			Если ЧастиЗапроса.Количество() = 2 Тогда
				ДанныеОбновлены = ЗагрузитьСтруктуруОбщегоМодуляПоЗапросу(ЧастиЗапроса);
			Иначе
				ДанныеОбновлены = ЗагрузитьСтруктуруМодуляМенеджераИлиОбъектаПоЗапросу(ЧастиЗапроса);
			КонецЕсли;
			
		Иначе
			
			ДанныеОбновлены = ЗагрузитьОбъектМетаданныхПоЗапросу(ПараметрыЗапроса);
			
		КонецЕсли;
		
	Иначе
		
		ДанныеОбновлены = ЗагрузитьСписокМетаданныхПоЗапросу(ПараметрыЗапроса);
		
	КонецЕсли;
	
	Если Событие.trigger = "suggestion" И ДанныеОбновлены Тогда
		View().triggerSuggestions();
	КонецЕсли;
	
	Если Событие.trigger = "snippet"  Тогда
		View().updateSnippetByGUID(Событие.snippet_guid);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаСобытияПолученияПеременной(Событие)
	
	ИмяПеременной = Событие.variableName;
	ИдентификаторПеременной = Событие.variableId;
	
	ПутьКДанным = Событие.variablePath;
	ПутьКДанным = СтрЗаменить(ПутьКДанным, "undefined", "");
	
	Описание = ПолучитьОписаниеПеременной(ИдентификаторПеременной, ИмяПеременной, ПутьКДанным, АдресХраненияПеременных);
	
	Если ЗначениеЗаполнено(Описание) Тогда
		View().updateVariableDescription(ИдентификаторПеременной, Описание);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейсРедактора

&НаКлиенте
Процедура ОбработатьИзменениеДокументаРабочейОбласти(ПараметрыСобытия)

	АлгоритмУИД = "";
	ВидДокумента = "";
	ИдентификаторДокумента = "";
	ИдентификаторСеанса = "";
	Попытка
		АлгоритмУИД = Строка(ПараметрыСобытия.algorithmId);
		ВидДокумента = Строка(ПараметрыСобытия.documentKind);
		ИдентификаторДокумента = Строка(ПараметрыСобытия.documentId);
		ИдентификаторСеанса = Строка(ПараметрыСобытия.sessionId);
	Исключение
	КонецПопытки;

	Если Не ПустаяСтрока(ИдентификаторСеанса) И ИдентификаторСеанса <> ИдентификаторРабочейОбласти Тогда
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(АлгоритмУИД) Или ПустаяСтрока(ВидДокумента) Или ПустаяСтрока(ИдентификаторДокумента) Тогда
		Возврат;
	КонецЕсли;

	// HTML-редактор является источником текста; нативная строка формы не обновляется при каждом вводе.

КонецПроцедуры

&НаКлиенте
Функция ПолучитьТекстДокументаРабочейОбласти(АлгоритмУИД, ВидДокумента)
	ИдентификаторДокумента = Строка(АлгоритмУИД) + ":" + Строка(ВидДокумента);
	Попытка
		Возврат QueryView().DataConsoleApp.getDocumentText(ИдентификаторДокумента);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ОбработатьАктивациюДокументаРабочейОбласти(ПараметрыСобытия)

	Попытка
		АлгоритмУИД = Строка(ПараметрыСобытия.algorithmId);
		ВидДокумента = Строка(ПараметрыСобытия.documentKind);
	Исключение
		Возврат;
	КонецПопытки;

	Алгоритм = НайтиАлгоритмРабочейОбласти(АлгоритмУИД);
	ИмяПоля = ИмяПоляАлгоритмаПоВидуДокумента(ВидДокумента);
	Если Алгоритм = Неопределено Или ПустаяСтрока(ИмяПоля) Тогда
		Возврат;
	КонецЕсли;

	// Выбор HTML-документа не должен активировать скрытое нативное дерево.
	ТекущийАлгоритм = Алгоритм.УИД;
	СтраницаКода = ?(ВидДокумента = "before-query", "КодЗапроса", ИмяПоля);
	ТекущееПоле = ИмяПоля + Алгоритм.УИД;
	Элементы.Значения.ОтборСтрок = Новый ФиксированнаяСтруктура("АлгоритмУИД", Алгоритм.УИД);
	УстановитьЗаголовокФормыДляАлгоритма(Алгоритм, ИмяПоля);
	ОбновитьПодсказкуПараметровHTML(АлгоритмУИД, ВидДокумента);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРедактированиеПараметраРабочейОбласти(ПараметрыСобытия)

	Если ТолькоПросмотр Или Не СоответствуетСеансуРабочейОбласти(ПараметрыСобытия) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		АлгоритмУИД = Строка(ПараметрыСобытия.algorithmId);
		ИдентификаторПараметра = Строка(ПараметрыСобытия.parameterId);
		Действие = Строка(ПараметрыСобытия.action);
	Исключение
		Возврат;
	КонецПопытки;

	Если ПустаяСтрока(АлгоритмУИД)
		Или ПустаяСтрока(ИдентификаторПараметра)
		Или (Действие <> "edit"
			И Действие <> "date"
			И Действие <> "string"
			И Действие <> "number"
			И Действие <> "value-list"
			И Действие <> "other"
			И Действие <> "clear") Тогда
		Возврат;
	КонецЕсли;

	Алгоритм = НайтиАлгоритмРабочейОбласти(АлгоритмУИД);
	Если Алгоритм = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗначениеПараметра = НайтиПараметрРабочейОбласти(АлгоритмУИД, ИдентификаторПараметра);
	Если ЗначениеПараметра = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Действие = "clear" Тогда
		ЗначениеПараметра.Значение = Неопределено;
		ЭтотОбъект.Модифицированность = Истина;
		ОбновитьПараметрыАлгоритмаHTML(АлгоритмУИД, ИдентификаторПараметра);
		ОбновитьСостояниеФайлаHTML();
		Возврат;
	КонецЕсли;

	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("sessionId", ИдентификаторРабочейОбласти);
	ДополнительныеПараметры.Вставить("algorithmId", АлгоритмУИД);
	ДополнительныеПараметры.Вставить("parameterId", ИдентификаторПараметра);
	Оповещение = Новый ОписаниеОповещения(
		"РедактированиеПараметраРабочейОбластиЗавершение", ЭтотОбъект, ДополнительныеПараметры);

	Попытка
		ЗаголовокВвода = "Значение параметра """ + ЗначениеПараметра.Имя + """";
		Если Действие = "date" Тогда
			НачальнаяДата = ?(ТипЗнч(ЗначениеПараметра.Значение) = Тип("Дата"),
				ЗначениеПараметра.Значение, Неопределено);
			ПоказатьВводДаты(Оповещение, НачальнаяДата, ЗаголовокВвода);
		ИначеЕсли Действие = "string" Тогда
			НачальнаяСтрока = ?(ТипЗнч(ЗначениеПараметра.Значение) = Тип("Строка"),
				ЗначениеПараметра.Значение, "");
			ПоказатьВводСтроки(Оповещение, НачальнаяСтрока, ЗаголовокВвода, 0, Истина);
		ИначеЕсли Действие = "number" Тогда
			НачальноеЧисло = ?(ТипЗнч(ЗначениеПараметра.Значение) = Тип("Число"),
				ЗначениеПараметра.Значение, 0);
			ПоказатьВводЧисла(Оповещение, НачальноеЧисло, ЗаголовокВвода, 15, 5);
		ИначеЕсли Действие = "value-list" Тогда
			Если ТипЗнч(ЗначениеПараметра.Значение) = Тип("СписокЗначений") Тогда
				НачальныйСписокЗначений = ЗначениеПараметра.Значение.Скопировать();
			Иначе
				НачальныйСписокЗначений = Новый СписокЗначений;
			КонецЕсли;
			ОписаниеТиповЗначения = Новый ОписаниеТипов("СписокЗначений");
			ПоказатьВводЗначения(Оповещение, НачальныйСписокЗначений,
				ЗаголовокВвода, ОписаниеТиповЗначения);
		Иначе
			ОписаниеТиповЗначения = ПолучитьОписаниеТиповЗначенияПараметраРабочейОбласти();
			ПоказатьВводЗначения(Оповещение, ЗначениеПараметра.Значение,
				ЗаголовокВвода, ОписаниеТиповЗначения);
		КонецЕсли;
	Исключение
		ВывестиОшибку("Не удалось открыть редактор значения параметра: " + ОписаниеОшибки(), Ложь);
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ПолучитьОписаниеТиповЗначенияПараметраРабочейОбласти()

	ТаблицаЗначенийПараметров = РеквизитФормыВЗначение("Значения");
	Возврат ТаблицаЗначенийПараметров.Колонки.Значение.ТипЗначения;

КонецФункции

&НаКлиенте
Процедура РедактированиеПараметраРабочейОбластиЗавершение(НовоеЗначение, ДополнительныеПараметры) Экспорт

	Если НовоеЗначение = Неопределено
		Или ТолькоПросмотр
		Или Не СоответствуетСеансуРабочейОбласти(ДополнительныеПараметры) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		АлгоритмУИД = Строка(ДополнительныеПараметры.algorithmId);
		ИдентификаторПараметра = Строка(ДополнительныеПараметры.parameterId);
	Исключение
		Возврат;
	КонецПопытки;

	Если НайтиАлгоритмРабочейОбласти(АлгоритмУИД) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗначениеПараметра = НайтиПараметрРабочейОбласти(АлгоритмУИД, ИдентификаторПараметра);
	Если ЗначениеПараметра = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗначениеПараметра.Значение = НовоеЗначение;
	ЭтотОбъект.Модифицированность = Истина;
	ОбновитьПараметрыАлгоритмаHTML(АлгоритмУИД, ИдентификаторПараметра);
	ОбновитьСостояниеФайлаHTML();

КонецПроцедуры

&НаКлиенте
Функция НайтиПараметрРабочейОбласти(АлгоритмУИД, ИдентификаторПараметра)

	Для Каждого ЗначениеПараметра Из ЭтотОбъект.Значения Цикл
		Если Строка(ЗначениеПараметра.АлгоритмУИД) = Строка(АлгоритмУИД)
			И Строка(ЗначениеПараметра.ПолучитьИдентификатор()) = Строка(ИдентификаторПараметра) Тогда
			Возврат ЗначениеПараметра;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Процедура ОбработатьКомандуТаблицРабочейОбласти(ПараметрыСобытия)

	Если ТолькоПросмотр Или Не СоответствуетСеансуРабочейОбласти(ПараметрыСобытия) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Действие = Строка(ПараметрыСобытия.action);
		ИдентификаторТаблицы = Строка(ПараметрыСобытия.tableId);
	Исключение
		Возврат;
	КонецПопытки;

	Если Действие = "toggle-measurements" Тогда
		ВключитьЗамеры(Неопределено);
		ОбновитьТаблицыHTML();
		Возврат;
	КонецЕсли;

	Если Действие <> "select-table" И Действие <> "export-table" Тогда
		Возврат;
	КонецЕсли;

	СтрокаТаблиц = НайтиТаблицуРабочейОбласти(ИдентификаторТаблицы);
	Если СтрокаТаблиц = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Элементы.Таблицы.ТекущаяСтрока = СтрокаТаблиц.ПолучитьИдентификатор();
	Если Действие = "export-table" Тогда
		ВывестиВТабДок(Неопределено);
		Возврат;
	КонецЕсли;

	Алгоритм = Неопределено;
	ТекстЗапроса = "";
	Попытка
		АктивныйДокумент = QueryView().DataConsoleApp.getActiveDocument();
		Если АктивныйДокумент <> Неопределено Тогда
			Алгоритм = НайтиАлгоритмРабочейОбласти(Строка(АктивныйДокумент.algorithmId));
			ТекстЗапроса = ПолучитьТекстДокументаРабочейОбласти(
				Строка(АктивныйДокумент.algorithmId), "query");
		КонецЕсли;
	Исключение
		Алгоритм = Неопределено;
	КонецПопытки;
	Если Алгоритм = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОтобразитьРезультатВременнойТаблицы(СтрокаТаблиц.РезультатЗапроса, ТекстЗапроса);
	ПозиционироватьВТекстеИмяТаблицы(СтрокаТаблиц.ИмяТаблицы);

КонецПроцедуры

&НаКлиенте
Функция НайтиТаблицуРабочейОбласти(ИдентификаторТаблицы)

	Для Каждого СтрокаТаблиц Из Таблицы Цикл
		Если Строка(СтрокаТаблиц.ПолучитьИдентификатор()) = ИдентификаторТаблицы Тогда
			Возврат СтрокаТаблиц;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Процедура ОбработатьКомандуНастроекРабочейОбласти(ПараметрыСобытия)

	Если Не СоответствуетСеансуРабочейОбласти(ПараметрыСобытия) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Действие = Строка(ПараметрыСобытия.action);
	Исключение
		Возврат;
	КонецПопытки;

	Если Действие = "choose-source-directory" Тогда
		КаталогИсходногоКодаКонфигурацииНачалоВыбора(Неопределено, Неопределено, Ложь);
		Возврат;
	ИначеЕсли Действие = "load-common-modules" Тогда
		ЗагрузитьОбщиеМодули(Неопределено);
		Возврат;
	КонецЕсли;

	Попытка
		ЗначениеНастройки = ПараметрыСобытия.value;
	Исключение
		Возврат;
	КонецПопытки;

	Если Действие = "set-editor-option" Тогда
		Попытка
			ИмяНастройки = Строка(ПараметрыСобытия.name);
		Исключение
			Возврат;
		КонецПопытки;
		Если Не УстановитьНастройкуРедактораMonaco(ИмяНастройки, ЗначениеНастройки) Тогда
			Возврат;
		КонецЕсли;
		ПрименитьНастройкиРедактораMonaco();
	ИначеЕсли Действие = "set-source-directory" Тогда
		Объект.КаталогИсходногоКодаКонфигурации = СокрЛП(Строка(ЗначениеНастройки));
	ИначеЕсли Действие = "set-variable-display-mode" Тогда
		Попытка
			РежимОтображенияПеременных = Число(ЗначениеНастройки);
		Исключение
			Возврат;
		КонецПопытки;
		Если РежимОтображенияПеременных < 0 Или РежимОтображенияПеременных > 2 Тогда
			Возврат;
		КонецЕсли;
		ПоказыватьЗначенияПеременныхПослеВыполнения = Цел(РежимОтображенияПеременных);
	ИначеЕсли Действие = "set-saved-list-limit" Тогда
		Попытка
			ОграничениеСписка = Число(ЗначениеНастройки);
		Исключение
			Возврат;
		КонецПопытки;
		Если ОграничениеСписка < 0 Или ОграничениеСписка > 9999 Тогда
			Возврат;
		КонецЕсли;
		КоличествоСохраняемыхЭлементовСписковЗначений = Цел(ОграничениеСписка);
	ИначеЕсли Действие = "set-auto-save-on-execute" Тогда
		Если ТипЗнч(ЗначениеНастройки) <> Тип("Булево") Тогда
			Возврат;
		КонецЕсли;
		СохранятьКодПриВыполнении = ЗначениеНастройки;
	Иначе
		Возврат;
	КонецЕсли;

	ОбновитьНастройкиHTML();

КонецПроцедуры

&НаКлиенте
Функция УстановитьНастройкуРедактораMonaco(ИмяНастройки, ЗначениеНастройки)

	Если ИмяНастройки = "theme" Тогда
		Если ТипЗнч(ЗначениеНастройки) <> Тип("Строка") Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ЗначениеНастройки <> "light" И ЗначениеНастройки <> "dark" Тогда
			Возврат Ложь;
		КонецЕсли;
		ТемаРедактораMonaco = ЗначениеНастройки;
		Возврат Истина;
	ИначеЕсли ИмяНастройки = "fontSize" Тогда
		Если ТипЗнч(ЗначениеНастройки) <> Тип("Число")
			Или ЗначениеНастройки < 10 Или ЗначениеНастройки > 28
			Или ЗначениеНастройки <> Цел(ЗначениеНастройки) Тогда
			Возврат Ложь;
		КонецЕсли;
		РазмерШрифтаРедактораMonaco = ЗначениеНастройки;
		Возврат Истина;
	КонецЕсли;

	Если ТипЗнч(ЗначениеНастройки) <> Тип("Булево") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ИмяНастройки = "lineNumbers" Тогда
		ОтображатьНомераСтрокРедактораMonaco = ЗначениеНастройки;
	ИначеЕсли ИмяНастройки = "minimap" Тогда
		ВидимостьКартыКода = ЗначениеНастройки;
	ИначеЕсли ИмяНастройки = "wordWrap" Тогда
		ПереноситьДлинныеСтрокиРедактораMonaco = ЗначениеНастройки;
	ИначеЕсли ИмяНастройки = "renderWhitespace" Тогда
		ОтображатьПробелыИТабуляции = ЗначениеНастройки;
	ИначеЕсли ИмяНастройки = "quickSuggestions" Тогда
		БыстрыеПодсказки = ЗначениеНастройки;
	ИначеЕсли ИмяНастройки = "statusBar" Тогда
		ВидимостьСтрокиСостояния = ЗначениеНастройки;
	ИначеЕсли ИмяНастройки = "queryHighlighting" Тогда
		ПодсвечиватьЗапросы = ЗначениеНастройки;
	Иначе
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура ПрименитьНастройкиРедактораMonaco()

	УстановитьПометкуТемы(?(ТемаРедактораMonaco = "dark", "ТемнаяТема", "СветлаяТема"));
	Элементы.АвтоИзменениеРазмера.Пометка = АвтоИзменениеРазмера;
	Элементы.ПодсвечиватьЗапросы.Пометка = ПодсвечиватьЗапросы;
	УправлениеБыстрымиПодсказками();
	УправлениеВидимостьюКартыКода();
	УправлениеВидимостьюСтрокиСостояния();
	Элементы.ОтображатьПробелыИТабуляции.Пометка = ОтображатьПробелыИТабуляции;

	Если Не ДокументЗагружен Или Не ВебДокументДоступен() Тогда
		Возврат;
	КонецЕсли;

	ИмяТемы = ПолучитьИмяТемы()
		+ ?(СтраницаКода = "КодЗапроса" Или ПодсвечиватьЗапросы, "-query", "");
	ПереключитьТему(ИмяТемы);
	View().setOption("autoResizeEditorLayout", АвтоИзменениеРазмера);
	View().setOption("fontSize", РазмерШрифтаРедактораMonaco);
	View().setOption("lineNumbers", ?(ОтображатьНомераСтрокРедактораMonaco, "on", "off"));
	View().minimap(ВидимостьКартыКода);
	View().setOption("wordWrap", ?(ПереноситьДлинныеСтрокиРедактораMonaco, "on", "off"));
	View().renderWhitespace(ОтображатьПробелыИТабуляции);
	View().setOption("quickSuggestions", БыстрыеПодсказки);
	Если ВидимостьСтрокиСостояния Тогда
		View().showStatusBar();
	Иначе
		View().hideStatusBar();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция СоответствуетСеансуРабочейОбласти(ПараметрыСобытия)

	Попытка
