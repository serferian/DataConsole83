	КонецЕсли;
	
	Результат = Запрос.Выполнить();
	
	ИмяТаблицыРезультата = "Выгрузка";
	ПодготовитьКолонкиТаблицы(ИмяТаблицыРезультата, Результат.Колонки);
	Выгрузка.Загрузить(Результат.Выгрузить());
	ПронумероватьСтроки(Выгрузка);
