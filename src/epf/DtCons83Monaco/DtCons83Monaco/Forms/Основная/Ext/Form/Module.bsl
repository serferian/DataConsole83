	ПрименитьНастройкиРедактораMonaco();
	ОбновитьНастройкиHTML();
	
КонецПроцедуры

&НаКлиенте
Процедура Настройки(Команда)
	Если ДокументЗагружен И ВебДокументДоступен() Тогда
		Попытка
			Результат = QueryView().DataConsoleApp.toggleSettings();
			Элементы.ФормаНастройки.Пометка = Результат.visible;
			Элементы.Настройки.Видимость = Ложь;
			Возврат;
		Исключение
		КонецПопытки;
	КонецЕсли;

	Элементы.ФормаНастройки.Пометка = НЕ Элементы.ФормаНастройки.Пометка;
	Элементы.Настройки.Видимость = Элементы.ФормаНастройки.Пометка;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОбщиеМодули(Команда)
	
	КаталогИсходногоКода = ПолучитьКаталогИсходногоКода();
	
	Если ЗначениеЗаполнено(КаталогИсходногоКода) Тогда
		
		КаталогМодулей = КаталогИсходногоКода + "CommonModules";
		КаталогНаДиске = Новый Файл(КаталогМодулей);
		
		Если КаталогНаДиске.Существует() Тогда
			ПараметрыЗагрузки = Новый Структура("КаталогМодулей", КаталогМодулей);
			Оповещение = Новый ОписаниеОповещения("ВопросЗагрузкиОбщихМодулейЗавершение", ЭтотОбъект, ПараметрыЗагрузки);
			ТекстВопроса = "Загрузка всех общих модулей может занять длительное время
			|и потребовать значительных ресурсов памяти. Всё равно продолжить?";
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтображатьПробелыИТабуляции(Команда)
	
	ОтображатьПробелыИТабуляции = НЕ ОтображатьПробелыИТабуляции;
	ПрименитьНастройкиРедактораMonaco();
	ОбновитьНастройкиHTML();
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостьюПробеловТабуляций()

	Элементы.ОтображатьПробелыИТабуляции.Пометка = ОтображатьПробелыИТабуляции;
	CodeView().renderWhitespace(ОтображатьПробелыИТабуляции);
	QueryView().renderWhitespace(ОтображатьПробелыИТабуляции);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПодсказкуПараметров(Команда)
	Элементы.ФормаПоказатьПодсказкуПараметров.Пометка = НЕ Элементы.ФормаПоказатьПодсказкуПараметров.Пометка;
	Если ДокументЗагружен И ВебДокументДоступен() Тогда
		Элементы.ГруппаПодсказки.Видимость = Ложь;
		Попытка
			АктивныйДокумент = QueryView().DataConsoleApp.getActiveDocument();
			Если АктивныйДокумент <> Неопределено Тогда
				ОбновитьПодсказкуПараметровHTML(
					Строка(АктивныйДокумент.algorithmId),
					Строка(АктивныйДокумент.documentKind));
			КонецЕсли;
		Исключение
			ВывестиОшибку("Не удалось обновить подсказку параметров HTML-редактора: " + ОписаниеОшибки(), Ложь);
		КонецПопытки;
		Возврат;
	КонецЕсли;
	ОбновитьПодсказку();
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПоказатьУИД(Команда)
	Если Элементы.Значения.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УИД = СериализаторXDTO.XMLСтрока(Элементы.Значения.ТекущиеДанные.Значение);
	Данные = Новый ЭлементБуфераОбмена(СтандартныйФорматДанныхБуфераОбмена.Текст,
		УИД);
	Ждать СредстваБуфераОбмена.ПоместитьДанныеАсинх(Данные);
	Сообщить("Скопирован в буфер обмена: " + УИД);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКолонкуВПараметр(Команда)
	Если ТекущийАлгоритм = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Элементы.Выгрузка.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗагрузитьКолонкуВПараметрНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьКолонкуВПараметрНаСервере()
	ТекущаяКолонки = СтрРазделить(ТекущийЭлемент.ТекущийЭлемент.ПутьКДанным, ".", Ложь);
	Если ТекущаяКолонки.Количество() < 2 Тогда
		Сообщить("Не выбрана колонка");
		Возврат;
	КонецЕсли;
	ТекущаяКолонка = ТекущаяКолонки[1];
	
	Отбор = Новый Структура;
	Отбор.Вставить("АлгоритмУИД", ТекущийАлгоритм);
	Отбор.Вставить("Имя", ТекущаяКолонка);
	НайденныеПараметры = Значения.НайтиСтроки(Отбор);
	Если НайденныеПараметры.Количество() = 0 Тогда
		НовыйПараметр = Значения.Добавить();
		НовыйПараметр.АлгоритмУИД = ТекущийАлгоритм;
		НовыйПараметр.Имя = ТекущаяКолонка;
	Иначе
		НовыйПараметр = НайденныеПараметры[0];
	КонецЕсли;
	НовыйПараметр.Значение = Новый СписокЗначений;
	
	Для Каждого СтрВыгрузка Из Выгрузка Цикл
		НовыйПараметр.Значение.Добавить(СтрВыгрузка[ТекущаяКолонка]);
	КонецЦикла;
КонецПроцедуры

