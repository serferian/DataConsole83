Функция СформироватьТаблицыРабочейОбласти()

	ТаблицыРабочейОбласти = Новый Массив;
	Для Каждого СтрокаТаблиц Из Таблицы Цикл
		ОписаниеТаблицы = Новый Структура();
		ОписаниеТаблицы.Вставить("id", Строка(СтрокаТаблиц.ПолучитьИдентификатор()));
		ОписаниеТаблицы.Вставить("name", СтрокаТаблиц.ИмяТаблицы);
		ОписаниеТаблицы.Вставить("rowCount", СтрокаТаблиц.Количество);
		ОписаниеТаблицы.Вставить("duration", СтрокаТаблиц.Замер);
		ТаблицыРабочейОбласти.Добавить(ОписаниеТаблицы);
	КонецЦикла;

	Возврат ТаблицыРабочейОбласти;

