&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработкаОбъект = ЭтотОбъект();
	
	ВерсияОбработки = ОбработкаОбъект.Метаданные().Комментарий;
	Если ПустаяСтрока(ВерсияОбработки) Тогда
		ВерсияОбработки = ОбработкаОбъект.СведенияОВнешнейОбработке().Версия;
	КонецЕсли;
	Если ПустаяСтрока(ВерсияОбработки) Тогда
		ВерсияОбработки = "5.0.8";
	КонецЕсли;
	
	АдресМакета = ПоместитьВоВременноеХранилище(ОбработкаОбъект.ПолучитьМакет("src"), Новый УникальныйИдентификатор());
	
	КоллекцияОбщихМодулей = ПолучитьКоллекциюОбщихМодулей();
	АдресОбщихМодулей = СохранитьОбщиеМодулиВХранилище(КоллекцияОбщихМодулей);
	ЗаполнитьИменаОбщихМодулей(КоллекцияОбщихМодулей);
	
	БыстрыеПодсказки = Истина;
	ВидимостьКартыКода = Ложь;
	ВидимостьСтрокиСостояния = Ложь;
	ПодсвечиватьЗапросы = Ложь;
	ТемаРедактораMonaco = "light";
	РазмерШрифтаРедактораMonaco = 14;
	ОтображатьНомераСтрокРедактораMonaco = Истина;
	ПереноситьДлинныеСтрокиРедактораMonaco = Ложь;
	ДокументЗагружен = Ложь;
	АвтоИзменениеРазмера = Истина;

	НастроитьВидимостьИнтерфейсаHTML();
	
	Элементы.КодФоновойОбработки.Доступность = НЕ ИнформационнаяБазаФайловая();
	Элементы.ФормаПоказатьПодсказкуПараметров.Пометка = Ложь;
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьИнтерфейсаHTML()

	ИменаСкрываемыхЭлементов = Новый Массив;
	ИменаСкрываемыхЭлементов.Добавить("ФормаКоманднаяПанель");
	ИменаСкрываемыхЭлементов.Добавить("Настройки");
	ИменаСкрываемыхЭлементов.Добавить("ГруппаАлгоритмыТексты");
	ИменаСкрываемыхЭлементов.Добавить("СтраницыКода");
	ИменаСкрываемыхЭлементов.Добавить("ГруппаПодсказки");
	ИменаСкрываемыхЭлементов.Добавить("ПолеКод");
	ИменаСкрываемыхЭлементов.Добавить("ПолеHTMLКод");
	ИменаСкрываемыхЭлементов.Добавить("Группа3");

	Для Каждого ИмяЭлемента Из ИменаСкрываемыхЭлементов Цикл
		ЭлементФормы = Элементы.Найти(ИмяЭлемента);
		Если ЭлементФормы <> Неопределено Тогда
			ЭлементФормы.Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;

	Элементы.ГруппаАлгоритмы.Видимость = Истина;
	Элементы.ГруппаАлгоритмы.РастягиватьПоГоризонтали = Истина;
	Элементы.ГруппаАлгоритмы.РастягиватьПоВертикали = Истина;
	Элементы.ГруппаАлгоритмыСКомандами.Видимость = Истина;
	Элементы.ГруппаАлгоритмыСКомандами.РастягиватьПоГоризонтали = Истина;
	Элементы.ГруппаАлгоритмыСКомандами.РастягиватьПоВертикали = Истина;
	Элементы.СтраницыHTMLПоля.Видимость = Истина;
	Элементы.СтраницыHTMLПоля.РастягиватьПоГоризонтали = Истина;
	Элементы.СтраницыHTMLПоля.РастягиватьПоВертикали = Истина;
	Элементы.ПолеЗапрос.Видимость = Истина;
	Элементы.ПолеHTML.Видимость = Истина;
	Элементы.ПолеHTML.РастягиватьПоГоризонтали = Истина;
	Элементы.ПолеHTML.РастягиватьПоВертикали = Истина;
	Элементы.ГруппаРезультат.Видимость = Истина;
	Элементы.ГруппаРезультат.РастягиватьПоГоризонтали = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Monaco +
	СнимокРабочейОбластиОжидающийСохранения = "";
	КомандаСохраненияРабочейОбласти = Неопределено;
	СохранениеРабочейОбластиЗапланировано = Ложь;
	ХешФайлаРабочейОбласти = "";
	Оповещение = Новый ОписаниеОповещения("ПослеПодключенияРасширенияДляРаботыСФайлами", ЭтотОбъект);
	НачатьПодключениеРасширенияРаботыСФайлами(Оповещение);
	ОпределитьРазделительПути();
	// Monaco -
	
	Если ЗначениеЗаполнено(Объект.ПолноеИмяФайла) Тогда
		Попытка
			ПрочитатьАлгоритмыИзФайла(Объект.ПолноеИмяФайла);
		Исключение
			Объект.ПолноеИмяФайла = "";
			Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ИнициализироватьКлиента", 1, Истина);
	ПодключитьОбработчикОжидания("ОбновитьСостояниеЗамеров", 0.1, Истина);
	
	АктивизироватьПоследнююСтрокуАлгоритма(Алгоритмы.ПолучитьЭлементы());
	УстановитьЗаголовокФормы();
	
	ОбновитьПодсказку();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	ЗапомнитьТекущийАлгоритмРабочейОбласти();

	Если ЭтотОбъект.Модифицированность Тогда
		Если ЗавершениеРаботы Тогда
			ТекстПредупреждения = НСтр("ru='Изменения текущих алгоритмов будут утеряны.';en='Current changes will be lost'");
		Иначе
			Оповещение = Новый ОписаниеОповещения("ОбработатьВопросПродолжения", ЭтаФорма, "ЗАКРЫТЬ");
			ТекстВопроса = НСтр(
			 "en='Current changes will be lost. Close data console?';"
			 "ru='Изменения текущих алгоритмов будут утеряны. Продолжить закрытие консоли алгоритмов?'");
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИндексныйФайл) Тогда
		Отказ = Истина;
		ЗакрытьКонсоль();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗапомнитьТекущийАлгоритмРабочейОбласти()
	Если Не ДокументЗагружен Или Не ВебДокументДоступен() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		АктивныйДокумент = QueryView().DataConsoleApp.getActiveDocument();
		Если АктивныйДокумент = Неопределено Тогда
			Возврат;
		КонецЕсли;

		АлгоритмУИД = Строка(АктивныйДокумент.algorithmId);
		Если ЗначениеЗаполнено(АлгоритмУИД) Тогда
			ЗапомнитьТекущийАлгоритмНаСервере(АлгоритмУИД);
		КонецЕсли;
	Исключение
		// Закрытие формы не должно блокироваться, если HTML-документ уже уничтожен.
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ЗапомнитьТекущийАлгоритмНаСервере(Знач АлгоритмУИД)
	ТекущийАлгоритм = АлгоритмУИД;
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	Сообщения = Новый Массив;
	
	Шаблон = "Задайте имя алгоритму";
	Для Каждого Алгоритм Из ЭтотОбъект.Алгоритмы.ПолучитьЭлементы() Цикл
		Если Не ЗначениеЗаполнено(Алгоритм.Имя) Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = Шаблон;
			Сообщение.Поле = "Алгоритмы[" + Алгоритм.ПолучитьИдентификатор() + "].Имя";
			Сообщения.Добавить(Сообщение);
		КонецЕсли;
	КонецЦикла;
	
	Шаблон = "Задайте имя значению параметров данных";
	Для Каждого Значение Из ЭтотОбъект.Значения Цикл
		Если Не ЗначениеЗаполнено(Значение.Имя) Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = Шаблон;
			Сообщение.Поле = "Значения[" + Значение.ПолучитьИдентификатор() + "].Имя";
			Сообщения.Добавить(Сообщение);
		КонецЕсли;
	КонецЦикла;
	
	Отказ = Сообщения.Количество() > 0;
	Для Каждого Сообщение Из Сообщения Цикл
		Сообщение.Сообщить();
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	ШрифтКода = Настройки["ШрифтКода"];
	ТекущийАлгоритм = Строка(Настройки["ТекущийАлгоритм"]);
	Элементы.ФормаСправка.Заголовок = Объект.Версия;
	
	Если ЗначениеЗаполнено(Настройки["СтраницаКода"]) Тогда
		Если Элементы.Найти(СтраницаКода) = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Элементы.СтраницыКода.ТекущаяСтраница = Элементы[СтраницаКода];
		Элементы.Алгоритмы.ТекущийЭлемент = Элементы["АлгоритмыЕсть" + СтраницаКода];
	КонецЕсли;
КонецПроцедуры

