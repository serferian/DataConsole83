Функция ПолучитьТекст(ДляВыполнения = Ложь)
	
	ДляВыполнения = ДляВыполнения И НЕ СтраницаКода = "КодЗапроса";
	Код = View().getText();
	
	Переменные = ?(ДляВыполнения, ПолучитьКодПросмотраПеременных(), "");
	
	Код = Код + Переменные;
	
	Возврат Код;
	
