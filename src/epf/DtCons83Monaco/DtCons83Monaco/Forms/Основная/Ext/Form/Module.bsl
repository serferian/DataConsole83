		Возврат;
	КонецЕсли;

	Алгоритм = ПараметрыОповещения.Алгоритм;
	Если ПараметрыОповещения.РезультатВHTML Тогда
		ОбновитьТекстДокументаHTML(Алгоритм.УИД, "query", Текст);
	Иначе
		Алгоритм.КодЗапроса = Текст;
		АлгоритмыОбновитьФлагиСтроки(Алгоритм);
		ОбновитьТекстДокументаHTML(Алгоритм.УИД, "query");
		ОбновитьТекст();
	КонецЕсли;
	ЭтотОбъект.Модифицированность = Истина;
	ОбновитьСостояниеФайлаHTML();
	
КонецПроцедуры

