Процедура ПрименитьИзменениеСтруктурыАлгоритмовHTML(Операция, ПредставлениеОперации)

	Операции = Новый Массив;
	Операции.Добавить(Операция);
	Изменения = Новый Структура("operations", Операции);

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Изменения);

	Попытка
		Результат = QueryView().DataConsoleApp.applyPatch(Запись.Закрыть());
		Попытка
			Если ЗначениеЗаполнено(Результат.errorDescription) Тогда
				ВывестиОшибку("Не удалось применить " + ПредставлениеОперации + ": "
					+ Результат.errorDescription, Ложь);
			КонецЕсли;
		Исключение
		КонецПопытки;
	Исключение
		ВывестиОшибку("Не удалось обновить структуру HTML-редактора: " + ОписаниеОшибки(), Ложь);
	КонецПопытки;

