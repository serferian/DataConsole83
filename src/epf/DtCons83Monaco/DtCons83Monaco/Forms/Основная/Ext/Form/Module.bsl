&НаКлиенте
Функция СформироватьПараметрыРабочейОбласти(АлгоритмУИД)

	ПараметрыРабочейОбласти = Новый Массив;
	Для Каждого ЗначениеПараметра Из ЭтотОбъект.Значения Цикл
		Если ЗначениеПараметра.АлгоритмУИД <> АлгоритмУИД Тогда
			Продолжить;
		КонецЕсли;

		ОписаниеПараметра = Новый Структура();
		ОписаниеПараметра.Вставить("id", Строка(ЗначениеПараметра.ПолучитьИдентификатор()));
		ОписаниеПараметра.Вставить("name", ЗначениеПараметра.Имя);
		ОписаниеПараметра.Вставить("typeName", Строка(ТипЗнч(ЗначениеПараметра.Значение)));
		ОписаниеПараметра.Вставить("presentation", ПредставлениеПараметраРабочейОбласти(ЗначениеПараметра.Значение));
		ОписаниеПараметра.Вставить("editableInline", Ложь);
		ПараметрыРабочейОбласти.Добавить(ОписаниеПараметра);
	КонецЦикла;

	Возврат ПараметрыРабочейОбласти;

