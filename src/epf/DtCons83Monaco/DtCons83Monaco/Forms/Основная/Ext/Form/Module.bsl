&НаКлиенте
Процедура ОткрытьКонструкторЗапросаДляАлгоритма(Алгоритм, ТекстЗапроса = Неопределено,
	РезультатВHTML = Ложь)

	Если Алгоритм = Неопределено Тогда
		ВывестиОшибку("Не выбран алгоритм для открытия конструктора запроса.", Ложь);
		Возврат;
	КонецЕсли;
	Если ТекстЗапроса = Неопределено Тогда
		ТекстЗапроса = Алгоритм.КодЗапроса;
	КонецЕсли;

	Попытка
		Конструктор = Новый КонструкторЗапроса();
		Конструктор.Текст = СокрЛП(ТекстЗапроса);

		ПараметрыОповещения = Новый Структура("Алгоритм,РезультатВHTML", Алгоритм, РезультатВHTML);
		Оповещение = Новый ОписаниеОповещения("УстановитьТекстЗапроса", ЭтотОбъект, ПараметрыОповещения);
		Конструктор.Показать(Оповещение);
	Исключение
		ВывестиОшибку("Не удалось открыть конструктор запроса: " + ОписаниеОшибки(), Ложь);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекстЗапроса(Текст, ПараметрыОповещения) Экспорт
