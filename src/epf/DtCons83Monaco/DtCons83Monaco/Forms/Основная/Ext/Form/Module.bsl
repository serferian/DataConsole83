	ОписаниеАлгоритма.Вставить("parameters", СформироватьПараметрыРабочейОбласти(Алгоритм.УИД));
	ОписаниеАлгоритма.Вставить("children", СформироватьАлгоритмыРабочейОбласти(Алгоритм.ПолучитьЭлементы()));

	Возврат ОписаниеАлгоритма;

