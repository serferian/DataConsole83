КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПодсказку()
	Если ДокументЗагружен И ВебДокументДоступен() Тогда
		Элементы.ГруппаПодсказки.Видимость = Ложь;
		Возврат;
	КонецЕсли;

	Элементы.ГруппаПодсказки.Видимость = Элементы.ФормаПоказатьПодсказкуПараметров.Пометка;
	Если НЕ Элементы.ГруппаПодсказки.Видимость Тогда
		Возврат;
	КонецЕсли;
	ПодсказкаПоПараметрам = "";
	ТекущаяСтраница = Элементы.СтраницыКода.ТекущаяСтраница;
	Если ТекущаяСтраница.Имя = "КодЗапроса" Тогда
		Если Элементы.СтраницыHTMLПоля.ТекущаяСтраница = Элементы.ПолеКод Тогда
			ПодсказкаКодаЗапросаПередВыполнением();
		КонецЕсли;
	ИначеЕсли ТекущаяСтраница.Имя = "КодКлиента1С" Тогда
		ПодсказкаКодаКлиентСервер();
	ИначеЕсли ТекущаяСтраница.Имя = "КодСервера1С" Тогда
		ПодсказкаКодаКлиентСервер();
	ИначеЕсли ТекущаяСтраница.Имя = "КодФоновойОбработки" Тогда
		ПодсказкаКодаФоноваяОбработка();
	КонецЕсли;
	
КонецПроцедуры

