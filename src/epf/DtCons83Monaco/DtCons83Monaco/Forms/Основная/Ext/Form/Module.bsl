&НаКлиенте
Функция НайтиАлгоритмРабочейОбласти(АлгоритмУИД, СтрокиАлгоритмов = Неопределено)

	Если СтрокиАлгоритмов = Неопределено Тогда
		СтрокиАлгоритмов = ЭтотОбъект.Алгоритмы.ПолучитьЭлементы();
	КонецЕсли;

	Для Каждого Алгоритм Из СтрокиАлгоритмов Цикл
		Если Алгоритм.УИД = АлгоритмУИД Тогда
			Возврат Алгоритм;
		КонецЕсли;

		НайденныйАлгоритм = НайтиАлгоритмРабочейОбласти(АлгоритмУИД, Алгоритм.ПолучитьЭлементы());
		Если НайденныйАлгоритм <> Неопределено Тогда
			Возврат НайденныйАлгоритм;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция АктивироватьДокументРабочейОбласти()

	Алгоритм = Элементы.Алгоритмы.ТекущиеДанные;
	ВидДокумента = ВидДокументаПоИмениПоляАлгоритма(СтраницаКода);
	Если Алгоритм = Неопределено Или ПустаяСтрока(ВидДокумента) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		РабочаяОбласть = QueryView().DataConsoleApp;
		Если РабочаяОбласть = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Если РабочаяОбласть.getActiveDocument() = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		РезультатАктивации = РабочаяОбласть.activateDocument(Алгоритм.УИД, ВидДокумента);
		Попытка
			Если ЗначениеЗаполнено(РезультатАктивации.errorDescription) Тогда
				Возврат Ложь;
			КонецЕсли;
		Исключение
		КонецПопытки;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

