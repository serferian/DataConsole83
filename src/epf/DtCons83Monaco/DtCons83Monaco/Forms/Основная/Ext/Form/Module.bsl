&НаКлиенте
Функция СформироватьПодсказкуПараметровРабочейОбласти(ВидДокумента)

	ЭлементыПодсказки = Новый Массив;
	Если ВидДокумента = "before-query" Тогда
		ДобавитьЭлементПодсказкиПараметров(ЭлементыПодсказки, "ПараметрыЗапроса", "Соответствие",
			"Параметры запроса, которые можно дополнить расчётными значениями");
		ДобавитьЭлементПодсказкиПараметров(ЭлементыПодсказки, "МенеджерВременныхТаблиц",
			"МенеджерВременныхТаблиц", "Позволяет предварительно заполнить временные таблицы");
	ИначеЕсли ВидДокумента = "client" Или ВидДокумента = "server" Тогда
		ДобавитьЭлементПодсказкиПараметров(ЭлементыПодсказки, "Выгрузка", "ДанныеФормыКоллекция",
			"Представление выборки результата запроса");
		ДобавитьЭлементПодсказкиПараметров(ЭлементыПодсказки, "ВыгрузкаДерево",
			"ДанныеФормыКоллекцияЭлементовДерева", "Представление дерева результата запроса");
		ДобавитьЭлементПодсказкиПараметров(ЭлементыПодсказки, "Параметры", "Структура",
			"Параметры выполнения кода");
	ИначеЕсли ВидДокумента = "background" Тогда
		ДобавитьЭлементПодсказкиПараметров(ЭлементыПодсказки, "ДополнительныеПараметры", "Структура",
			"Параметры фонового обработчика");
		ДобавитьЭлементПодсказкиПараметров(ЭлементыПодсказки, "Данные", "Массив структур",
			"Данные порции для обработки", 1);
	КонецЕсли;

	ОписаниеПодсказки = Новый Структура();
	ОписаниеПодсказки.Вставить("visible",
		ЭлементыПодсказки.Количество() > 0 И Элементы.ФормаПоказатьПодсказкуПараметров.Пометка);
	ОписаниеПодсказки.Вставить("items", ЭлементыПодсказки);

	Возврат ОписаниеПодсказки;

