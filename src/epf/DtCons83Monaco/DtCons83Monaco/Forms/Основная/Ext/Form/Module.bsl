Функция СформироватьДокументыРабочейОбласти(Алгоритм)

	Документы = Новый Массив;
	ДобавитьДокументРабочейОбласти(Документы, Алгоритм, "query", "Запрос", "КодЗапроса");
	ДобавитьДокументРабочейОбласти(Документы, Алгоритм, "before-query", "Перед выполнением запроса",
		"КодЗапросаПередВыполнениемЗапроса");
	ДобавитьДокументРабочейОбласти(Документы, Алгоритм, "client", "Код клиента", "КодКлиента1С");
	ДобавитьДокументРабочейОбласти(Документы, Алгоритм, "server", "Код сервера", "КодСервера1С");
	ДобавитьДокументРабочейОбласти(Документы, Алгоритм, "background", "Фоновый код", "КодФоновойОбработки");

	Возврат Документы;

