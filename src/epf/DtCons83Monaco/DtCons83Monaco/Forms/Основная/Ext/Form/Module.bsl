Процедура ДобавитьДокументРабочейОбласти(Документы, Алгоритм, ВидДокумента, Заголовок, ИмяПоля)

	ТекстДокумента = Алгоритм[ИмяПоля];
	Документ = Новый Структура();
	Документ.Вставить("id", Алгоритм.УИД + ":" + ВидДокумента);
	Документ.Вставить("kind", ВидДокумента);
	Документ.Вставить("title", Заголовок);
	Документ.Вставить("text", ТекстДокумента);
	Документ.Вставить("hasContent", ЗначениеЗаполнено(ТекстДокумента));
	Документы.Добавить(Документ);

