&НаКлиенте
Функция ИмяПоляАлгоритмаПоВидуДокумента(ВидДокумента)

	Если ВидДокумента = "query" Тогда
		Возврат "КодЗапроса";
	ИначеЕсли ВидДокумента = "before-query" Тогда
		Возврат "КодЗапросаПередВыполнениемЗапроса";
	ИначеЕсли ВидДокумента = "client" Тогда
		Возврат "КодКлиента1С";
	ИначеЕсли ВидДокумента = "server" Тогда
		Возврат "КодСервера1С";
	ИначеЕсли ВидДокумента = "background" Тогда
		Возврат "КодФоновойОбработки";
	КонецЕсли;

	Возврат "";

