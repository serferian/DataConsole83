Функция СформироватьНастройкиРабочейОбласти()

	НастройкиРабочейОбласти = Новый Структура();
	НастройкиРабочейОбласти.Вставить("sourceDirectory", Объект.КаталогИсходногоКодаКонфигурации);
	НастройкиРабочейОбласти.Вставить("variableDisplayMode", ПоказыватьЗначенияПеременныхПослеВыполнения);
	НастройкиРабочейОбласти.Вставить("savedListLimit", КоличествоСохраняемыхЭлементовСписковЗначений);
	НастройкиРабочейОбласти.Вставить("autoSaveOnExecute", СохранятьКодПриВыполнении);

	НастройкиФоновогоВыполнения = Новый Структура();
	НастройкиФоновогоВыполнения.Вставить("jobCount", КоличествоФоновыхЗаданий);
	НастройкиФоновогоВыполнения.Вставить("batchSize", Цел(ПорцияДанных));
	НастройкиФоновогоВыполнения.Вставить("safeMode", Не ОтключитьБезопасныйРежим);
	НастройкиРабочейОбласти.Вставить("background", НастройкиФоновогоВыполнения);

	НастройкиРедактора = Новый Структура();
	НастройкиРедактора.Вставить("theme", ТемаРедактораMonaco);
	НастройкиРедактора.Вставить("fontSize", РазмерШрифтаРедактораMonaco);
	НастройкиРедактора.Вставить("lineNumbers", ОтображатьНомераСтрокРедактораMonaco);
	НастройкиРедактора.Вставить("minimap", ВидимостьКартыКода);
	НастройкиРедактора.Вставить("wordWrap", ПереноситьДлинныеСтрокиРедактораMonaco);
	НастройкиРедактора.Вставить("renderWhitespace", ОтображатьПробелыИТабуляции);
	НастройкиРедактора.Вставить("quickSuggestions", БыстрыеПодсказки);
	НастройкиРедактора.Вставить("statusBar", ВидимостьСтрокиСостояния);
	НастройкиРедактора.Вставить("queryHighlighting", ПодсвечиватьЗапросы);
	НастройкиРабочейОбласти.Вставить("editor", НастройкиРедактора);

	Возврат НастройкиРабочейОбласти;

