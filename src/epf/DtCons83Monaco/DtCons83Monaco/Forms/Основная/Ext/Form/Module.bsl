&НаКлиенте
Процедура ОбработатьСохранениеРабочейОбласти(ПараметрыСобытия, СохранитьКак = Ложь)

	Если ТолькоПросмотр Или Не СоответствуетСеансуРабочейОбласти(ПараметрыСобытия) Тогда
		Возврат;
	КонецЕсли;

	ЗначениеСнимка = Неопределено;
	Попытка
		ЗначениеСнимка = ПараметрыСобытия.workspaceJson;
	Исключение
		ЗначениеСнимка = Неопределено;
	КонецПопытки;
	Если ТипЗнч(ЗначениеСнимка) = Тип("Строка")
		И ЗначениеЗаполнено(ЗначениеСнимка) Тогда
		СнимокРабочейОбластиОжидающийСохранения = ЗначениеСнимка;
	Иначе
		ОбработатьИзменениеДокументаРабочейОбласти(ПараметрыСобытия);
	КонецЕсли;
	КомандаСохраненияРабочейОбласти = ?(СохранитьКак,
		Команды.ФайлСохранитьКак, Команды.ФайлСохранить);
	Если Не СохранениеРабочейОбластиЗапланировано Тогда
		СохранениеРабочейОбластиЗапланировано = Истина;
		ПодключитьОбработчикОжидания(
			"ВыполнитьОтложенноеСохранениеРабочейОбласти", 0.1, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеСтруктурыРабочейОбласти(ПараметрыСобытия)

	Если ТолькоПросмотр Или Не СоответствуетСеансуРабочейОбласти(ПараметрыСобытия) Тогда
		Возврат;
	КонецЕсли;

	АлгоритмУИД = "";
	Попытка
		Действие = Строка(ПараметрыСобытия.action);
		АлгоритмУИД = Строка(ПараметрыСобытия.algorithmId);
	Исключение
		Возврат;
	КонецПопытки;

	ДопустимоеДействие = Действие = "add-algorithm"
		Или Действие = "rename-algorithm"
		Или Действие = "delete-algorithm"
		Или Действие = "add-parameter"
		Или Действие = "copy-parameter"
		Или Действие = "delete-parameter";
	Если Не ДопустимоеДействие Тогда
		Возврат;
	КонецЕсли;

	ОбработатьИзменениеДокументаРабочейОбласти(ПараметрыСобытия);

	Если Действие = "add-algorithm" Тогда
		Попытка
			Имя = Лев(СокрЛП(Строка(ПараметрыСобытия.name)), 150);
			РодительАлгоритмаУИД = Строка(ПараметрыСобытия.parentAlgorithmId);
		Исключение
			Возврат;
		КонецПопытки;
		ДобавитьАлгоритмРабочейОбласти(Имя, РодительАлгоритмаУИД);
	ИначеЕсли Действие = "rename-algorithm" Тогда
		Попытка
			Имя = Лев(СокрЛП(Строка(ПараметрыСобытия.name)), 150);
		Исключение
			Возврат;
		КонецПопытки;
		ПереименоватьАлгоритмРабочейОбласти(АлгоритмУИД, Имя);
	ИначеЕсли Действие = "delete-algorithm" Тогда
		УдалитьАлгоритмРабочейОбласти(АлгоритмУИД);
	ИначеЕсли Действие = "add-parameter" Тогда
		Попытка
			Имя = Лев(СокрЛП(Строка(ПараметрыСобытия.name)), 150);
		Исключение
			Возврат;
		КонецПопытки;
		ДобавитьПараметрРабочейОбласти(АлгоритмУИД, Имя);
	ИначеЕсли Действие = "copy-parameter" Тогда
		Попытка
			ИдентификаторПараметра = Строка(ПараметрыСобытия.parameterId);
		Исключение
			Возврат;
		КонецПопытки;
		КопироватьПараметрРабочейОбласти(АлгоритмУИД, ИдентификаторПараметра);
	ИначеЕсли Действие = "delete-parameter" Тогда
		Попытка
			ИдентификаторПараметра = Строка(ПараметрыСобытия.parameterId);
		Исключение
			Возврат;
		КонецПопытки;
		УдалитьПараметрРабочейОбласти(АлгоритмУИД, ИдентификаторПараметра);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьАлгоритмРабочейОбласти(Имя, РодительАлгоритмаУИД)

	Если ПустаяСтрока(Имя) Тогда
		Возврат;
	КонецЕсли;

	КоллекцияАлгоритмов = ЭтотОбъект.Алгоритмы.ПолучитьЭлементы();
	Если Не ПустаяСтрока(РодительАлгоритмаУИД) Тогда
		РодительАлгоритма = НайтиАлгоритмРабочейОбласти(РодительАлгоритмаУИД);
		Если РодительАлгоритма = Неопределено Тогда
			Возврат;
		КонецЕсли;
		КоллекцияАлгоритмов = РодительАлгоритма.ПолучитьЭлементы();
	КонецЕсли;

	НовыйАлгоритм = КоллекцияАлгоритмов.Добавить();
	НовыйАлгоритм.Имя = Имя;
	НовыйАлгоритм.УИД = Строка(Новый УникальныйИдентификатор);
	Если Не ПустаяСтрока(РодительАлгоритмаУИД) Тогда
		СкопироватьПараметрыАлгоритмаРабочейОбласти(РодительАлгоритмаУИД, НовыйАлгоритм.УИД);
	КонецЕсли;
	АлгоритмыОбновитьФлагиСтроки(НовыйАлгоритм);

	Элементы.Алгоритмы.ТекущаяСтрока = НовыйАлгоритм.ПолучитьИдентификатор();
	УстановитьОтборЗначений();
	ТекущееПоле = "";
	ЭтотОбъект.Модифицированность = Истина;
	УстановитьЗаголовокФормы();
	ОбновитьДобавленныйАлгоритмHTML(НовыйАлгоритм, РодительАлгоритмаУИД);

КонецПроцедуры

&НаКлиенте
Процедура СкопироватьПараметрыАлгоритмаРабочейОбласти(ИсходныйАлгоритмУИД, НовыйАлгоритмУИД)

	ИсходныеПараметры = Новый Массив;
	Для Каждого Параметр Из ЭтотОбъект.Значения Цикл
		Если Параметр.АлгоритмУИД = ИсходныйАлгоритмУИД Тогда
			ИсходныеПараметры.Добавить(Параметр);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ИсходныйПараметр Из ИсходныеПараметры Цикл
		НовыйПараметр = ЭтотОбъект.Значения.Добавить();
		НовыйПараметр.Имя = ИсходныйПараметр.Имя;
		НовыйПараметр.АлгоритмУИД = НовыйАлгоритмУИД;
		Если ТипЗнч(ИсходныйПараметр.Значение) = Тип("СписокЗначений") Тогда
			НовыйПараметр.Значение = ИсходныйПараметр.Значение.Скопировать();
		Иначе
			НовыйПараметр.Значение = ИсходныйПараметр.Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПереименоватьАлгоритмРабочейОбласти(АлгоритмУИД, Имя)

	Алгоритм = НайтиАлгоритмРабочейОбласти(АлгоритмУИД);
	Если Алгоритм = Неопределено Или ПустаяСтрока(Имя) Или Алгоритм.Имя = Имя Тогда
		Возврат;
	КонецЕсли;

	Алгоритм.Имя = Имя;
	ЭтотОбъект.Модифицированность = Истина;
	УстановитьЗаголовокФормы();
	ОбновитьИмяАлгоритмаHTML(АлгоритмУИД, Имя);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьАлгоритмРабочейОбласти(АлгоритмУИД)

	Алгоритм = НайтиАлгоритмРабочейОбласти(АлгоритмУИД);
	Если Алгоритм = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УИДыУдаляемыхАлгоритмов = Новый Соответствие;
	СобратьУИДыАлгоритмаРабочейОбласти(Алгоритм, УИДыУдаляемыхАлгоритмов);
	УдалитьПараметрыАлгоритмовРабочейОбласти(УИДыУдаляемыхАлгоритмов);

	РодительАлгоритма = Алгоритм.ПолучитьРодителя();
	КоллекцияАлгоритмов = ?(РодительАлгоритма = Неопределено,
		ЭтотОбъект.Алгоритмы.ПолучитьЭлементы(), РодительАлгоритма.ПолучитьЭлементы());
	КоллекцияАлгоритмов.Удалить(Алгоритм);

	НовыйТекущийАлгоритм = РодительАлгоритма;
	Если НовыйТекущийАлгоритм = Неопределено И КоллекцияАлгоритмов.Количество() > 0 Тогда
		НовыйТекущийАлгоритм = КоллекцияАлгоритмов[0];
	КонецЕсли;

	Если НовыйТекущийАлгоритм = Неопределено Тогда
		ТекущийАлгоритм = "";
		Элементы.Значения.ОтборСтрок = Новый ФиксированнаяСтруктура("АлгоритмУИД", "");
	Иначе
		Элементы.Алгоритмы.ТекущаяСтрока = НовыйТекущийАлгоритм.ПолучитьИдентификатор();
		УстановитьОтборЗначений();
	КонецЕсли;

	ТекущееПоле = "";
	ЭтотОбъект.Модифицированность = Истина;
	УстановитьЗаголовокФормы();
	ОбновитьУдаленныйАлгоритмHTML(АлгоритмУИД, ?(НовыйТекущийАлгоритм = Неопределено,
		"", НовыйТекущийАлгоритм.УИД));

КонецПроцедуры

&НаКлиенте
Процедура СобратьУИДыАлгоритмаРабочейОбласти(Алгоритм, УИДыАлгоритмов)

	УИДыАлгоритмов.Вставить(Алгоритм.УИД, Истина);
	Для Каждого ДочернийАлгоритм Из Алгоритм.ПолучитьЭлементы() Цикл
		СобратьУИДыАлгоритмаРабочейОбласти(ДочернийАлгоритм, УИДыАлгоритмов);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УдалитьПараметрыАлгоритмовРабочейОбласти(УИДыАлгоритмов)

	УдаляемыеПараметры = Новый Массив;
	Для Каждого ПараметрАлгоритма Из ЭтотОбъект.Значения Цикл
		Если УИДыАлгоритмов[ПараметрАлгоритма.АлгоритмУИД] <> Неопределено Тогда
			УдаляемыеПараметры.Добавить(ПараметрАлгоритма);
		КонецЕсли;
	КонецЦикла;

	Для Каждого УдаляемыйПараметр Из УдаляемыеПараметры Цикл
		ЭтотОбъект.Значения.Удалить(УдаляемыйПараметр);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПараметрРабочейОбласти(АлгоритмУИД, Имя)

	Алгоритм = НайтиАлгоритмРабочейОбласти(АлгоритмУИД);
	Если Алгоритм = Неопределено Или ПустаяСтрока(Имя) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ПараметрАлгоритма Из ЭтотОбъект.Значения Цикл
		Если ПараметрАлгоритма.АлгоритмУИД = АлгоритмУИД
			И НРег(ПараметрАлгоритма.Имя) = НРег(Имя) Тогда
			ПоказатьПредупреждение(, "Параметр с таким именем уже существует.");
			Возврат;
		КонецЕсли;
	КонецЦикла;

	НовыйПараметр = ЭтотОбъект.Значения.Добавить();
	НовыйПараметр.Имя = Имя;
	НовыйПараметр.АлгоритмУИД = АлгоритмУИД;
	НовыйПараметр.Значение = Неопределено;
	Элементы.Значения.ТекущаяСтрока = НовыйПараметр.ПолучитьИдентификатор();
	ЭтотОбъект.Модифицированность = Истина;

	ОбновитьПараметрыАлгоритмаHTML(АлгоритмУИД, Строка(НовыйПараметр.ПолучитьИдентификатор()));

КонецПроцедуры

&НаКлиенте
Процедура КопироватьПараметрРабочейОбласти(АлгоритмУИД, ИдентификаторПараметра)

	Алгоритм = НайтиАлгоритмРабочейОбласти(АлгоритмУИД);
	ИсходныйПараметр = НайтиПараметрРабочейОбласти(АлгоритмУИД, ИдентификаторПараметра);
	Если Алгоритм = Неопределено Или ИсходныйПараметр = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НомерКопии = 1;
	Пока Истина Цикл
		СуффиксИмени = "Копия" + ?(НомерКопии = 1, "", Строка(НомерКопии));
		ИмяКопии = Лев(ИсходныйПараметр.Имя, 150 - СтрДлина(СуффиксИмени)) + СуффиксИмени;
		ИмяЗанято = Ложь;
		Для Каждого ПараметрАлгоритма Из ЭтотОбъект.Значения Цикл
			Если ПараметрАлгоритма.АлгоритмУИД = АлгоритмУИД
				И НРег(ПараметрАлгоритма.Имя) = НРег(ИмяКопии) Тогда
				ИмяЗанято = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ИмяЗанято Тогда
			Прервать;
		КонецЕсли;
		НомерКопии = НомерКопии + 1;
	КонецЦикла;

	НовыйПараметр = ЭтотОбъект.Значения.Добавить();
	НовыйПараметр.Имя = ИмяКопии;
	НовыйПараметр.АлгоритмУИД = АлгоритмУИД;
	Если ТипЗнч(ИсходныйПараметр.Значение) = Тип("СписокЗначений") Тогда
		НовыйПараметр.Значение = ИсходныйПараметр.Значение.Скопировать();
	Иначе
		НовыйПараметр.Значение = ИсходныйПараметр.Значение;
	КонецЕсли;

	Элементы.Значения.ТекущаяСтрока = НовыйПараметр.ПолучитьИдентификатор();
	ЭтотОбъект.Модифицированность = Истина;
	ОбновитьПараметрыАлгоритмаHTML(АлгоритмУИД, Строка(НовыйПараметр.ПолучитьИдентификатор()));
	ОбновитьСостояниеФайлаHTML();

КонецПроцедуры

&НаКлиенте
Процедура УдалитьПараметрРабочейОбласти(АлгоритмУИД, ИдентификаторПараметра)

	УдаляемыйПараметр = Неопределено;
	Для Каждого ПараметрАлгоритма Из ЭтотОбъект.Значения Цикл
		Если ПараметрАлгоритма.АлгоритмУИД = АлгоритмУИД
			И Строка(ПараметрАлгоритма.ПолучитьИдентификатор()) = ИдентификаторПараметра Тогда
			УдаляемыйПараметр = ПараметрАлгоритма;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если УдаляемыйПараметр = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЭтотОбъект.Значения.Удалить(УдаляемыйПараметр);
	ЭтотОбъект.Модифицированность = Истина;
	ОбновитьПараметрыАлгоритмаHTML(АлгоритмУИД);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьКомандуРабочейОбласти(ПараметрыСобытия)

	ТекстДокумента = Неопределено;
	ЗначениеТекстаДокумента = Неопределено;
	Попытка
		ИдентификаторСеанса = Строка(ПараметрыСобытия.sessionId);
		АлгоритмУИД = Строка(ПараметрыСобытия.algorithmId);
		ИдентификаторДокумента = Строка(ПараметрыСобытия.documentId);
		ВидДокумента = Строка(ПараметрыСобытия.documentKind);
		Действие = Строка(ПараметрыСобытия.action);
		Попытка
			ЗначениеТекстаДокумента = ПараметрыСобытия.documentText;
		Исключение
			ЗначениеТекстаДокумента = Неопределено;
		КонецПопытки;
		Если ТипЗнч(ЗначениеТекстаДокумента) = Тип("Строка") Тогда
			ТекстДокумента = ЗначениеТекстаДокумента;
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;

	Если ПустаяСтрока(ИдентификаторСеанса)
		Или ИдентификаторСеанса <> ИдентификаторРабочейОбласти
		Или ПустаяСтрока(АлгоритмУИД)
		Или ПустаяСтрока(ИдентификаторДокумента)
		Или ПустаяСтрока(ВидДокумента)
		Или ПустаяСтрока(Действие) Тогда
		Возврат;
	КонецЕсли;

	Алгоритм = НайтиАлгоритмРабочейОбласти(АлгоритмУИД);
	ИмяПоля = ИмяПоляАлгоритмаПоВидуДокумента(ВидДокумента);
	ОжидаемыйИдентификаторДокумента = Строка(АлгоритмУИД) + ":" + ВидДокумента;
	Если Алгоритм = Неопределено
		Или ПустаяСтрока(ИмяПоля)
		Или ИдентификаторДокумента <> ОжидаемыйИдентификаторДокумента Тогда
		Возврат;
	КонецЕсли;

	Если Действие = "toggle-parameter-hint" Тогда
		ПоказатьПодсказкуПараметров(Неопределено);
		Возврат;
	КонецЕсли;

	Если ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;

	КодПередВыполнением = Неопределено;
	Если ВидДокумента = "query" Тогда
		Попытка
			КодПередВыполнением = QueryView().DataConsoleApp.getDocumentText(
				Строка(АлгоритмУИД) + ":before-query");
		Исключение
		КонецПопытки;
	КонецЕсли;

	ДопустимоеДействие = (ВидДокумента = "query" И Действие = "execute-query")
		Или (ВидДокумента = "query" И Действие = "execute-query-to-cursor")
		Или (ВидДокумента = "query" И Действие = "execute-query-package")
		Или (ВидДокумента = "query" И Действие = "open-query-constructor")
		Или (ВидДокумента = "query" И Действие = "fill-parameters")
		Или (ВидДокумента = "query" И Действие = "format-query")
		Или (ВидДокумента = "query" И Действие = "get-query-code")
		Или (ВидДокумента = "before-query" И Действие = "execute-query")
		Или (ВидДокумента = "client" И Действие = "execute-client")
		Или (ВидДокумента = "client" И Действие = "insert-iteration-example")
		Или (ВидДокумента = "client" И Действие = "insert-list-load-example")
		Или (ВидДокумента = "server" И Действие = "execute-server")
		Или (ВидДокумента = "server" И Действие = "insert-iteration-example")
		Или (ВидДокумента = "server" И Действие = "insert-list-load-example")
		Или (ВидДокумента = "server" И Действие = "insert-storage-example")
		Или (ВидДокумента = "background" И Действие = "execute-background")
		Или (ВидДокумента = "background" И Действие = "stop-background")
		Или (ВидДокумента = "background" И Действие = "insert-background-example")
		Или (ВидДокумента = "background" И Действие = "update-background-setting");
	Если Не ДопустимоеДействие Тогда
		Возврат;
	КонецЕсли;

	Если ВидДокумента = "query" И Действие = "open-query-constructor" Тогда
		// Для HTML-редактора используем уже проверенный алгоритм, не полагаясь на текущую строку скрытого дерева формы.
		ОткрытьКонструкторЗапросаДляАлгоритма(Алгоритм,
			ПолучитьТекстДокументаРабочейОбласти(АлгоритмУИД, ВидДокумента), Истина);
		Возврат;
	КонецЕсли;
	Если ВидДокумента = "query" И Действие = "fill-parameters" Тогда
		ОпределитьПараметрыЗапросаДляАлгоритма(Алгоритм,
			ПолучитьТекстДокументаРабочейОбласти(АлгоритмУИД, ВидДокумента));
		ОбновитьПараметрыАлгоритмаHTML(АлгоритмУИД);
		ОбновитьСостояниеФайлаHTML();
		Возврат;
	КонецЕсли;
	Если ВидДокумента = "query" И Действие = "format-query" Тогда
		ТекстЗапросаHTML = ПолучитьТекстДокументаРабочейОбласти(АлгоритмУИД, ВидДокумента);
		ОтформатированныйТекст = ФорматироватьТекстЗапроса(ТекстЗапросаHTML);
		Если ОтформатированныйТекст <> Неопределено Тогда
			ОбновитьТекстДокументаHTML(АлгоритмУИД, ВидДокумента, ОтформатированныйТекст);
		КонецЕсли;
		ЭтотОбъект.Модифицированность = Истина;
		ОбновитьСостояниеФайлаHTML();
		Возврат;
	КонецЕсли;

	Если ЭтоДействиеВыполненияРабочейОбласти(Действие) Тогда
		// Выполнение из HTML не должно активировать скрытые страницы и таблицу алгоритмов формы.
		ТекущийАлгоритм = Алгоритм.УИД;
		Элементы.Значения.ОтборСтрок = Новый ФиксированнаяСтруктура("АлгоритмУИД", ТекущийАлгоритм);
	КонецЕсли;
	Если ЭтоДействиеВыполненияРабочейОбласти(Действие)
		И СохранятьКодПриВыполнении
		И ЗначениеЗаполнено(Объект.ПолноеИмяФайла) Тогда
		ФайлСохранить(Команды.ФайлСохранить);
	КонецЕсли;

	Если ВидДокумента = "background" И Действие = "update-background-setting" Тогда
		Попытка
			ИмяНастройки = Строка(ПараметрыСобытия.settingName);
			ЗначениеНастройки = ПараметрыСобытия.settingValue;
		Исключение
			Возврат;
		КонецПопытки;

		Если ИмяНастройки = "jobCount" Тогда
			Попытка
				КоличествоФоновыхЗаданий = Цел(ЗначениеНастройки);
			Исключение
				Возврат;
			КонецПопытки;
			Если КоличествоФоновыхЗаданий < 1 Тогда
				КоличествоФоновыхЗаданий = 1;
			ИначеЕсли КоличествоФоновыхЗаданий > 10 Тогда
				КоличествоФоновыхЗаданий = 10;
			КонецЕсли;
			КоличествоФоновыхЗаданийПриИзменении(Неопределено);
		ИначеЕсли ИмяНастройки = "safeMode" Тогда
			Если ТипЗнч(ЗначениеНастройки) <> Тип("Булево") Тогда
				Возврат;
			КонецЕсли;
			ОтключитьБезопасныйРежим = Не ЗначениеНастройки;
		Иначе
			Возврат;
		КонецЕсли;

		ОбновитьНастройкиHTML();
		Возврат;
	КонецЕсли;

	Если ВидДокумента = "query" Тогда
		Если Действие = "execute-query" Тогда
			ВыполнитьКод("КодЗапроса", Неопределено, Алгоритм, Истина,
				ТекстДокумента, КодПередВыполнением);
		ИначеЕсли Действие = "execute-query-to-cursor" Тогда
			ВыполнитьКод("КодЗапроса", "ДоКурсора", Алгоритм, Истина,
				ТекстДокумента, КодПередВыполнением);
		ИначеЕсли Действие = "execute-query-package" Тогда
			ВыполнитьКод("КодЗапроса", "ПакетныйЗапрос", Алгоритм, Истина,
				ТекстДокумента, КодПередВыполнением);
		ИначеЕсли Действие = "get-query-code" Тогда
			ПолучитьКодДляВставки(Неопределено, Алгоритм, ТекстДокумента);
		КонецЕсли;
	ИначеЕсли ВидДокумента = "before-query" Тогда
		Если Действие = "execute-query" Тогда
			ТекстЗапросаHTML = ТекстДокумента;
			Попытка
				ТекстЗапросаHTML = QueryView().DataConsoleApp.getDocumentText(
					Строка(АлгоритмУИД) + ":query");
			Исключение
			КонецПопытки;
			ВыполнитьКод("КодЗапроса", Неопределено, Алгоритм, Ложь,
				ТекстЗапросаHTML, ТекстДокумента);
		КонецЕсли;
	ИначеЕсли ВидДокумента = "client" Тогда
		Если Действие = "execute-client" Тогда
			ВыполнитьКод("КодКлиента1С", Неопределено, Алгоритм, Истина, ТекстДокумента);
		ИначеЕсли Действие = "insert-iteration-example" Тогда
			ПримерКода(Неопределено, Алгоритм, ИмяПоля);
			ЭтотОбъект.Модифицированность = Истина;
		ИначеЕсли Действие = "insert-list-load-example" Тогда
			ПримерЗагрузкиКодаВСписок(Неопределено, Алгоритм, ИмяПоля);
			ЭтотОбъект.Модифицированность = Истина;
		КонецЕсли;
	ИначеЕсли ВидДокумента = "server" Тогда
		Если Действие = "execute-server" Тогда
			ВыполнитьКод("КодСервера1С", Неопределено, Алгоритм, Истина, ТекстДокумента);
		ИначеЕсли Действие = "insert-iteration-example" Тогда
			ПримерКода(Неопределено, Алгоритм, ИмяПоля);
			ЭтотОбъект.Модифицированность = Истина;
		ИначеЕсли Действие = "insert-list-load-example" Тогда
			ПримерЗагрузкиКодаВСписок(Неопределено, Алгоритм, ИмяПоля);
			ЭтотОбъект.Модифицированность = Истина;
		ИначеЕсли Действие = "insert-storage-example" Тогда
			ПримерКодаПолученияДанныхИзХранилища(Неопределено, Алгоритм, ИмяПоля);
			ЭтотОбъект.Модифицированность = Истина;
		КонецЕсли;
	ИначеЕсли ВидДокумента = "background" Тогда
		Если Действие = "execute-background" Тогда
			ВыполнитьСерверныйКодВФоне(Неопределено, Алгоритм, ТекстДокумента);
		ИначеЕсли Действие = "stop-background" Тогда
			ОстановитьВыполнениеВФонеНажатие(Неопределено);
		ИначеЕсли Действие = "insert-background-example" Тогда
			ПримерВФонеНажатие(Неопределено, Алгоритм, ИмяПоля);
			ЭтотОбъект.Модифицированность = Истина;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ЭтоДействиеВыполненияРабочейОбласти(Действие)

	Возврат Действие = "execute-query"
		Или Действие = "execute-query-to-cursor"
		Или Действие = "execute-query-package"
		Или Действие = "execute-client"
		Или Действие = "execute-server"
		Или Действие = "execute-background";

КонецФункции

&НаКлиенте
Функция View()
	
	Если СтраницаКода = "КодЗапроса" Тогда
		Возврат QueryView();
	Иначе
		Возврат CodeView();
	КонецЕсли;
	
КонецФункции

&НаКлиенте
